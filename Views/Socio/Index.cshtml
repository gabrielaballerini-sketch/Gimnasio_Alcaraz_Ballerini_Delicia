@{
    ViewData["Title"] = "Socios";
}

<div id="app" class="mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Socios</h2>
        <button class="btn btn-primary" @@click="abrirCrear">Nuevo socio</button>
    </div>

    <!-- Aviso (toast) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div v-if="aviso.texto" v-cloak class="toast show align-items-center text-white border-0"
             v-bind:class="aviso.tipo === 'ok' ? 'bg-success' : 'bg-danger'">
            <div class="d-flex">
                <div class="toast-body">{{ aviso.texto }}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        v-on:click="aviso.texto = ''"></button>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación (baja / reactivar) -->
    <div class="modal fade" tabindex="-1" ref="modalConfirmar">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center fs-2"
                         style="width:64px;height:64px"
                         v-bind:class="confirmacion.tipo === 'danger' ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'">
                        {{ confirmacion.tipo === 'danger' ? '!' : '✓' }}
                    </div>

                    <h5 class="mb-2">{{ confirmacion.titulo }}</h5>
                    <p class="text-muted mb-3">{{ confirmacion.mensaje }}</p>

                    <div v-if="confirmacion.socio" class="bg-light rounded p-2 mb-3">
                        <div class="fw-semibold">{{ confirmacion.socio.apellido }}, {{ confirmacion.socio.nombre }}
                        </div>
                        <small class="text-muted">DNI {{ confirmacion.socio.dni }}</small>
                    </div>

                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn px-4"
                                v-bind:class="confirmacion.tipo === 'danger' ? 'btn-danger' : 'btn-success'"
                                v-on:click="confirmar">{{ confirmacion.textoBoton }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal crear / modificar socio -->
    <div class="modal fade" tabindex="-1" ref="modalSocio" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <form @@submit.prevent="guardar" autocomplete="off" novalidate>

                    <div class="modal-header">
                        <h5 class="modal-title">{{ editando ? 'Modificar socio' : 'Nuevo socio' }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <div v-if="errorModal" v-cloak class="alert alert-danger">
                            <div>{{ errorModal }}</div>
                            <ul class="mb-0" v-if="erroresModal.length">
                                <li v-for="e in erroresModal" v-bind:key="e">{{ e }}</li>
                            </ul>
                        </div>

                        <h6 class="text-uppercase text-muted small mb-3">Datos del socio</h6>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Nombre</label>
                                <input class="form-control" v-model="form.nombre">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellido</label>
                                <input class="form-control" v-model="form.apellido">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">DNI</label>
                                <input class="form-control" v-model="form.dni">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Teléfono</label>
                                <input class="form-control" v-model="form.telefono">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Domicilio</label>
                                <input class="form-control" v-model="form.domicilio">
                            </div>
                        </div>

                        <!-- Cuenta de acceso: solo al crear -->
                        <template v-if="!editando">

                            <hr class="my-4">

                            <h6 class="text-uppercase text-muted small mb-1">Cuenta de acceso</h6>
                            <p class="text-muted small mb-3">
                                Son obligatorios: el socio no se crea sin su usuario.
                            </p>

                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" v-model="cuenta.email"
                                           autocomplete="new-password">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Contraseña</label>
                                    <input type="password" class="form-control" v-model="cuenta.password"
                                           autocomplete="new-password">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Confirmar contraseña</label>
                                    <input type="password" class="form-control" v-model="cuenta.confirmarPassword"
                                           autocomplete="new-password">
                                </div>
                            </div>

                        </template>

                        <div v-else class="alert alert-light border small mt-4 mb-0">
                            El usuario de este socio se administra desde la pantalla de Usuarios.
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" v-bind:disabled="guardando || !puedeGuardar">
                            {{ guardando ? 'Guardando...' : (editando ? 'Guardar cambios' : 'Crear socio y usuario') }}
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- Pestañas -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a href="#" class="nav-link" v-bind:class="{ active: pestana === 'activos' }"
               v-on:click.prevent="cambiarPestana('activos')">Activos</a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link" v-bind:class="{ active: pestana === 'inactivos' }"
               v-on:click.prevent="cambiarPestana('inactivos')">Inactivos</a>
        </li>
    </ul>

    <!-- Tabla -->
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Apellido y nombre</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Domicilio</th>
                <th>Cuenta</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="s in socios" v-bind:key="s.idSocio">
                <td>{{ s.apellido }}, {{ s.nombre }}</td>
                <td>{{ s.dni }}</td>
                <td>{{ s.telefono }}</td>
                <td>{{ s.domicilio }}</td>
                <td>
                    <span class="badge" v-bind:class="s.idUsuario ? 'bg-success' : 'bg-warning text-dark'">
                        {{ s.idUsuario ? 'Con usuario' : 'Sin usuario' }}
                    </span>
                </td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary me-1" v-on:click="editar(s)">Editar</button>
                    <button class="btn btn-sm btn-outline-danger" v-if="pestana === 'activos'"
                            v-on:click="pedirBaja(s)">Dar de baja</button>
                    <button class="btn btn-sm btn-outline-success" v-if="pestana === 'inactivos'"
                            v-on:click="pedirReactivar(s)">Reactivar</button>
                </td>
            </tr>
            <tr v-if="socios.length === 0">
                <td colspan="6" class="text-center text-muted">No hay socios para mostrar.</td>
            </tr>
        </tbody>
    </table>

    <!-- Paginación -->
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <label class="me-2">Por página:</label>
            <select class="form-select d-inline-block w-auto" v-model.number="tamPagina" v-on:change="cambiarTamano">
                <option v-bind:value="5">5</option>
                <option v-bind:value="10">10</option>
                <option v-bind:value="20">20</option>
            </select>
            <span class="ms-3 text-muted">{{ total }} socios en total</span>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-2" v-bind:disabled="pagina <= 1"
                    v-on:click="irAPagina(pagina - 1)">Anterior</button>
            <span>Página {{ pagina }} de {{ totalPaginas }}</span>
            <button class="btn btn-outline-secondary btn-sm ms-2" v-bind:disabled="pagina >= totalPaginas"
                    v-on:click="irAPagina(pagina + 1)">Siguiente</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script>
        const API = '/api/socios';

        const formVacio = () => ({
            idSocio: 0, nombre: '', apellido: '', dni: '', telefono: '', domicilio: ''
        });

        const cuentaVacia = () => ({
            email: '', password: '', confirmarPassword: ''
        });

        const confirmacionVacia = () => ({
            titulo: '', mensaje: '', textoBoton: '', tipo: 'danger', socio: null, accion: null
        });

        Vue.createApp({
            data() {
                return {
                    socios: [],
                    pestana: 'activos',
                    pagina: 1,
                    tamPagina: 10,
                    total: 0,
                    totalPaginas: 1,
                    token: '',
                    editando: false,
                    form: formVacio(),
                    cuenta: cuentaVacia(),
                    guardando: false,
                    errorModal: '',
                    erroresModal: [],
                    aviso: { tipo: 'ok', texto: '' },
                    temporizadorAviso: null,
                    confirmacion: confirmacionVacia(),
                    modalConfirmar: null,
                    modalSocio: null
                };
            },
            computed: {
                // Al crear, el socio no se puede guardar sin los datos de la cuenta
                puedeGuardar() {
                    if (this.editando) return true;
                    return this.cuenta.email.trim() !== ''
                        && this.cuenta.password !== ''
                        && this.cuenta.confirmarPassword !== '';
                }
            },
            async mounted() {
                this.modalConfirmar = new bootstrap.Modal(this.$refs.modalConfirmar);
                this.modalSocio = new bootstrap.Modal(this.$refs.modalSocio);
                await this.iniciar();
            },
            methods: {

                // ---------- Token JWT ----------
                async iniciar() {
                    try {
                        const resp = await fetch('/Cuenta/Token', { credentials: 'same-origin' });

                        if (!resp.ok) {
                            this.mostrarAviso('error', 'No se pudo obtener el token. Volvé a iniciar sesión.');
                            return;
                        }

                        const datos = await resp.json();
                        this.token = datos.token;

                        await this.cargar();
                    }
                    catch (e) {
                        this.mostrarAviso('error', 'No se pudo conectar con el servidor.');
                    }
                },

                // Todas las llamadas a la API llevan el JWT
                async peticionApi(url, opciones = {}) {
                    const headers = new Headers(opciones.headers || {});
                    headers.set('Authorization', `Bearer ${this.token}`);

                    return fetch(url, { ...opciones, headers, credentials: 'same-origin' });
                },

                // ---------- Avisos ----------
                mostrarAviso(tipo, texto) {
                    this.aviso = { tipo, texto };
                    clearTimeout(this.temporizadorAviso);
                    this.temporizadorAviso = setTimeout(() => { this.aviso.texto = ''; }, 4000);
                },

                // ---------- Listado ----------
                async cargar() {
                    const resp = await this.peticionApi(
                        `${API}/${this.pestana}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`);

                    if (!resp.ok) {
                        this.socios = [];
                        this.mostrarAviso('error', resp.status === 403
                            ? 'No tenés permisos para ver esta lista.'
                            : 'No se pudieron cargar los socios.');
                        return;
                    }

                    const datos = await resp.json();

                    // Si quedó una página que ya no existe (por ejemplo, al dar de baja al último de la página), retrocede
                    if (this.pagina > datos.totalPaginas) {
                        this.pagina = datos.totalPaginas;
                        return this.cargar();
                    }

                    this.socios = datos.items;
                    this.total = datos.total;
                    this.totalPaginas = datos.totalPaginas;
                },
                cambiarPestana(nombre) {
                    if (this.pestana === nombre) return;
                    this.pestana = nombre;
                    this.pagina = 1;
                    this.cargar();
                },
                cambiarTamano() {
                    this.pagina = 1;
                    this.cargar();
                },
                irAPagina(numero) {
                    if (numero < 1 || numero > this.totalPaginas) return;
                    this.pagina = numero;
                    this.cargar();
                },

                // ---------- Alta / modificación ----------
                abrirCrear() {
                    this.editando = false;
                    this.form = formVacio();
                    this.cuenta = cuentaVacia();
                    this.errorModal = '';
                    this.erroresModal = [];
                    this.modalSocio.show();
                },
                editar(socio) {
                    this.editando = true;
                    this.form = {
                        idSocio: socio.idSocio,
                        nombre: socio.nombre,
                        apellido: socio.apellido,
                        dni: socio.dni,
                        telefono: socio.telefono,
                        domicilio: socio.domicilio
                    };
                    this.errorModal = '';
                    this.erroresModal = [];
                    this.modalSocio.show();
                },
                async guardar() {
                    if (this.guardando) return;

                    this.errorModal = '';
                    this.erroresModal = [];

                    if (!this.editando && this.cuenta.password !== this.cuenta.confirmarPassword) {
                        this.errorModal = 'Las contraseñas no coinciden.';
                        return;
                    }

                    this.guardando = true;

                    try {
                        // Al crear: los datos del socio + su usuario (email y contraseña)
                        const cuerpo = this.editando
                            ? this.form
                            : {
                                ...this.form,
                                usuario: {
                                    email: this.cuenta.email,
                                    password: this.cuenta.password
                                }
                            };

                        const resp = await this.peticionApi(
                            this.editando ? `${API}/${this.form.idSocio}` : API,
                            {
                                method: this.editando ? 'PUT' : 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(cuerpo)
                            });

                        if (!resp.ok) {
                            const error = await resp.json().catch(() => ({}));
                            this.errorModal = error.mensaje || 'No se pudo guardar el socio.';
                            this.erroresModal = error.errores || [];
                            return;
                        }

                        this.modalSocio.hide();
                        this.mostrarAviso('ok', this.editando
                            ? 'Socio actualizado correctamente.'
                            : 'Socio y usuario creados correctamente.');
                        await this.cargar();
                    }
                    catch (e) {
                        this.errorModal = 'No se pudo conectar con el servidor.';
                    }
                    finally {
                        this.guardando = false;
                    }
                },

                // ---------- Confirmaciones ----------
                pedirBaja(socio) {
                    this.confirmacion = {
                        titulo: 'Dar de baja al socio',
                        mensaje: 'Pasará a la lista de inactivos. Podés reactivarlo cuando quieras.',
                        textoBoton: 'Dar de baja',
                        tipo: 'danger',
                        socio,
                        accion: () => this.ejecutarBaja(socio)
                    };
                    this.modalConfirmar.show();
                },
                pedirReactivar(socio) {
                    this.confirmacion = {
                        titulo: 'Reactivar al socio',
                        mensaje: 'Volverá a la lista de socios activos.',
                        textoBoton: 'Reactivar',
                        tipo: 'success',
                        socio,
                        accion: () => this.ejecutarReactivar(socio)
                    };
                    this.modalConfirmar.show();
                },
                async confirmar() {
                    const accion = this.confirmacion.accion;
                    this.modalConfirmar.hide();
                    if (accion) await accion();
                },
                async ejecutarBaja(socio) {
                    const resp = await this.peticionApi(`${API}/${socio.idSocio}`, { method: 'DELETE' });

                    if (!resp.ok) {
                        const error = await resp.json().catch(() => ({}));
                        this.mostrarAviso('error', error.mensaje || 'No se pudo dar de baja.');
                        return;
                    }

                    this.mostrarAviso('ok', `${socio.apellido}, ${socio.nombre} fue dado de baja.`);
                    this.cargar();
                },
                async ejecutarReactivar(socio) {
                    const resp = await this.peticionApi(`${API}/${socio.idSocio}/reactivar`, { method: 'PUT' });

                    if (!resp.ok) {
                        const error = await resp.json().catch(() => ({}));
                        this.mostrarAviso('error', error.mensaje || 'No se pudo reactivar.');
                        return;
                    }

                    this.mostrarAviso('ok', `${socio.apellido}, ${socio.nombre} fue reactivado.`);
                    this.cargar();
                }
            }
        }).mount('#app');
    </script>
}