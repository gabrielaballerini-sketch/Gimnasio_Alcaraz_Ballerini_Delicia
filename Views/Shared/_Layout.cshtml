
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gimnasio ABD</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/Gimnasio_Alcaraz_Ballerini_Delicia.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Gimnasio ABD
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navbarPrincipal">

                    <!-- ENLACES PRINCIPALES -->
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Empleado") ||
                                 User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Socio"
                                       asp-action="Index">
                                        Socios
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Profesor"
                                       asp-action="Index">
                                        Profesores
                                    </a>
                                </li>
                            }

                            @* Planes, Actividades y Membresías: cada rol ve su propia versión *@
                            @if (User.IsInRole("Socio") ||
                                 User.IsInRole("Empleado") ||
                                 User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Plan"
                                       asp-action="Index">
                                        Planes
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Actividad"
                                       asp-action="Index">
                                        Actividades
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Membresia"
                                       asp-action="Index">
                                        @(User.IsInRole("Socio") ? "Mi membresía" : "Membresías")
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Usuario"
                                       asp-action="Index">
                                        Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- MENÚ DE USUARIO A LA DERECHA -->
                    <ul class="navbar-nav ms-auto mb-2 mb-sm-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark d-flex align-items-center"
                                   href="#"
                                   id="menuUsuario"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center me-2"
                                          style="width:28px;height:28px;font-size:.8rem;">
                                        @(string.IsNullOrWhiteSpace(User.Identity.Name)
                                            ? "U"
                                            : User.Identity.Name.Substring(0, 1).ToUpper())
                                    </span>

                                    @(User.Identity.Name ?? "Mi cuenta")
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="menuUsuario">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Cuenta"
                                           asp-action="EditarPerfil">
                                            Editar perfil
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-controller="Cuenta"
                                              asp-action="Logout"
                                              method="post">
                                            <button type="submit" class="dropdown-item">
                                                Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Cuenta"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Gimnasio_Alcaraz_Ballerini_Delicia -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
