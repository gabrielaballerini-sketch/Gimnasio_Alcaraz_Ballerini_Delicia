@{
    ViewData["Title"] = "Asistencias por actividad";
}

<div id="appPorActividad" class="container mt-4 mb-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1"><i class="bi bi-bar-chart me-2"></i>Asistencias por actividad</h1>
            <p class="text-muted mb-0">
                Cantidad de ingresos por actividad en un período. La musculación (sin clase) cuenta como una actividad más.
            </p>
        </div>

      
    </div>

    <div v-if="error" v-cloak class="alert alert-danger">{{ error }}</div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form v-on:submit.prevent="buscar">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Desde</label>
                        <input type="date" class="form-control" v-model="filtros.desde">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hasta</label>
                        <input type="date" class="form-control" v-model="filtros.hasta">
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" v-bind:disabled="cargando">
                            <span v-if="cargando" class="spinner-border spinner-border-sm"></span>
                            <i v-else class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm" v-if="datos">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Ingresos por actividad</h5>
                <span class="badge text-bg-secondary">Total: {{ datos.total }}</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Actividad</th>
                            <th class="text-end">Ingresos</th>
                            <th style="width:40%">%</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="f in datos.items" v-bind:key="f.actividad">
                            <td>{{ f.actividad }}</td>
                            <td class="text-end">{{ f.cantidad }}</td>
                            <td>
                                <div class="progress" style="height:.9rem;">
                                    <div class="progress-bar" v-bind:style="{ width: f.porcentaje + '%' }"></div>
                                </div>
                                <span class="small text-muted">{{ f.porcentaje }}%</span>
                            </td>
                        </tr>
                        <tr v-if="datos.items.length === 0">
                            <td colspan="3" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No hay asistencias en el período seleccionado.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script>
        const hoy = new Date();
        const iso = (d) => d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' +
            String(d.getDate()).padStart(2, '0');

        Vue.createApp({
            data() {
                return {
                    token: '',
                    cargando: false,
                    error: '',
                    datos: null,
                    filtros: {
                        desde: iso(new Date(hoy.getFullYear(), hoy.getMonth(), 1)),
                        hasta: iso(hoy)
                    }
                };
            },

            async mounted() {
                try {
                    const r = await fetch('/Cuenta/Token', { credentials: 'same-origin' });
                    if (!r.ok) throw new Error();
                    this.token = (await r.json()).token;
                } catch {
                    this.error = 'No se pudo obtener el token. Volvé a iniciar sesión.';
                    return;
                }

                await this.buscar();
            },

            methods: {
                async buscar() {
                    if (this.filtros.desde && this.filtros.hasta && this.filtros.desde > this.filtros.hasta) {
                        this.error = 'La fecha inicial no puede ser posterior a la fecha final.';
                        return;
                    }

                    this.cargando = true;
                    this.error = '';

                    const params = new URLSearchParams();
                    if (this.filtros.desde) params.set('desde', this.filtros.desde);
                    if (this.filtros.hasta) params.set('hasta', this.filtros.hasta);

                    try {
                        const r = await fetch('/api/asistencias/por-actividad?' + params.toString(), {
                            headers: { 'Accept': 'application/json', 'Authorization': 'Bearer ' + this.token },
                            credentials: 'same-origin'
                        });
                        const texto = await r.text();
                        const data = texto ? JSON.parse(texto) : {};

                        if (!r.ok) {
                            throw new Error(r.status === 401 || r.status === 403
                                ? 'Necesitás iniciar sesión como administrador.'
                                : (data.mensaje || 'No se pudo cargar el reporte.'));
                        }
                        this.datos = data;
                    } catch (e) {
                        this.datos = null;
                        this.error = e.message;
                    } finally {
                        this.cargando = false;
                    }
                }
            }
        }).mount('#appPorActividad');
    </script>
}
