@{
    ViewData["Title"] = "Mi utilización";
}

<div id="appUtilizacion" class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 me-2"></i>Mi utilización
            </h2>
            <p class="text-muted mb-0">
                Cuántas utilizaciones de tu plan usaste en el período actual.
            </p>
        </div>

        <a asp-controller="Asistencia" asp-action="Historial" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i> Ver historial completo
        </a>
    </div>

    <div v-if="mensaje" v-cloak class="alert alert-danger">{{ mensaje }}</div>

    <!-- Resumen del plan -->
    <div v-if="resumen" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">{{ resumen.plan || 'Sin membresía vigente' }}</h5>

            <div v-if="resumen.tienePeriodoVigente" class="row text-center g-3">
                <div class="col-md-3">
                    <div class="small text-muted">Período</div>
                    <div class="fw-semibold">{{ fecha(resumen.vigenteDesde) }} al {{ fecha(resumen.venceEl) }}</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">Permitidas</div>
                    <div class="fs-4 fw-bold">{{ resumen.ilimitado ? 'Ilimitado' : resumen.permitidas }}</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">Utilizadas</div>
                    <div class="fs-4 fw-bold">{{ resumen.utilizadas }}</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">Disponibles</div>
                    <div class="fs-4 fw-bold">{{ resumen.ilimitado ? 'Ilimitado' : resumen.disponibles }}</div>
                </div>
            </div>
            <div v-else class="text-muted">{{ resumen.motivo }}</div>
        </div>
    </div>

    <!-- Ingresos del período -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Ingresos de mi período actual</h5>
                <span class="badge text-bg-secondary">Total: {{ total }}</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y hora</th>
                            <th>Tipo</th>
                            <th>Clase</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr v-for="item in asistencias" v-bind:key="item.idAsistencia">
                            <td>{{ fechaHora(item.fechaHoraIngreso) }}</td>
                            <td>
                                <span class="badge"
                                      v-bind:class="item.tipo === 1 ? 'text-bg-info' : 'text-bg-primary'">
                                    {{ item.tipo === 1 ? 'Clase' : 'Musculación' }}
                                </span>
                            </td>
                            <td>
                                <template v-if="item.idClase">
                                    {{ item.clase && item.clase.actividad
                                        ? item.clase.actividad.nombre
                                        : 'Clase #' + item.idClase }}
                                </template>
                                <span v-else class="text-muted">No corresponde</span>
                            </td>
                        </tr>

                        <tr v-if="!cargando && asistencias.length === 0">
                            <td colspan="3" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                Todavía no registraste ingresos en este período.
                            </td>
                        </tr>

                        <tr v-if="cargando">
                            <td colspan="3" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Cargando...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <span class="text-muted small">Página {{ pagina }} de {{ totalPaginas }}</span>

                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-outline-secondary btn-sm"
                            v-on:click="irPagina(pagina - 1)"
                            v-bind:disabled="pagina <= 1 || cargando">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </button>

                    <button class="btn btn-outline-secondary btn-sm"
                            v-on:click="irPagina(pagina + 1)"
                            v-bind:disabled="pagina >= totalPaginas || cargando">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        Vue.createApp({
            data() {
                return {
                    resumen: null,
                    asistencias: [],
                    total: 0,
                    pagina: 1,
                    tamPagina: 10,
                    totalPaginas: 1,
                    cargando: false,
                    mensaje: ''
                };
            },

            mounted() {
                this.cargar();
            },

            methods: {
                async cargar() {
                    this.cargando = true;
                    this.mensaje = '';

                    const params = new URLSearchParams({
                        periodoActual: 'true',
                        pagina: this.pagina,
                        tamPagina: this.tamPagina
                    });

                    try {
                        const response = await fetch(
                            `/api/asistencias/mia?${params.toString()}`,
                            {
                                headers: { 'Accept': 'application/json' },
                                credentials: 'same-origin'
                            }
                        );

                        const texto = await response.text();
                        let data = {};

                        try {
                            data = texto ? JSON.parse(texto) : {};
                        } catch {
                            throw new Error('El servidor devolvió una respuesta inesperada.');
                        }

                        if (!response.ok) {
                            throw new Error(data.mensaje || 'No se pudo cargar tu utilización.');
                        }

                        this.resumen = data.resumen || null;
                        this.asistencias = data.items || [];
                        this.total = data.total || 0;
                        this.pagina = data.pagina || this.pagina;
                        this.tamPagina = data.tamPagina || this.tamPagina;
                        this.totalPaginas = Math.max(1, Math.ceil(this.total / this.tamPagina));
                    } catch (e) {
                        this.asistencias = [];
                        this.total = 0;
                        this.totalPaginas = 1;
                        this.mensaje = e.message;
                    } finally {
                        this.cargando = false;
                    }
                },

                irPagina(numero) {
                    if (numero < 1 || numero > this.totalPaginas) return;
                    this.pagina = numero;
                    this.cargar();
                },

                fechaHora(valor) {
                    if (!valor) return '-';
                    const f = new Date(valor);
                    return Number.isNaN(f.getTime()) ? '-' : f.toLocaleString('es-AR');
                },

                fecha(valor) {
                    return valor ? new Date(valor).toLocaleDateString('es-AR') : '-';
                }
            }
        }).mount('#appUtilizacion');
    </script>
}