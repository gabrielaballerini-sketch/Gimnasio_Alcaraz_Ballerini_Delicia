@{
    ViewData["Title"] = "Historial de asistencias";
    var esSocio = User.IsInRole("Socio");
}

<div id="appHistorial" class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clock-history me-2"></i>Historial de asistencias
            </h2>
            <p class="text-muted mb-0">
                Consultá los ingresos registrados en el gimnasio.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (esSocio)
            {
                <a asp-controller="Asistencia" asp-action="MiUtilizacion" class="btn btn-outline-secondary">
                    <i class="bi bi-speedometer2 me-1"></i> Mi utilización
                </a>
            }

            <a href="/Asistencia" class="btn btn-outline-primary">
                <i class="bi bi-person-check me-1"></i> Registrar asistencia
            </a>
        </div>
    </div>

    <div v-if="mensaje" v-cloak
         class="alert"
         v-bind:class="error ? 'alert-danger' : 'alert-info'">
        {{ mensaje }}
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form v-on:submit.prevent="nuevaBusqueda">
                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">Desde</label>
                        <input type="date" class="form-control" v-model="filtros.desde">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Hasta</label>
                        <input type="date" class="form-control" v-model="filtros.hasta">
                    </div>

                    <!-- Solo lo ve el administrador -->
                    <div class="col-md-2" v-if="!esSocio">
                        <label class="form-label">DNI del socio</label>
                        <input type="text" inputmode="numeric" maxlength="10"
                               class="form-control" autocomplete="off"
                               v-model.trim="filtros.dni" placeholder="Sin puntos">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Por página</label>
                        <select class="form-select" v-model.number="tamPagina">
                            <option v-bind:value="5">5</option>
                            <option v-bind:value="10">10</option>
                            <option v-bind:value="20">20</option>
                            <option v-bind:value="50">50</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1"
                                v-bind:disabled="cargando">
                            <span v-if="cargando"
                                  class="spinner-border spinner-border-sm"></span>
                            <i v-else class="bi bi-search"></i>
                            Buscar
                        </button>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            v-on:click="limpiarFiltros">
                        Limpiar filtros
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Período vigente (solo socio) -->
    <div v-if="esSocio && modoPeriodo" v-cloak
         class="alert alert-info d-flex flex-wrap align-items-center gap-3">
        <i class="bi bi-calendar-check fs-4"></i>

        <div class="flex-grow-1">
            <template v-if="resumen && resumen.tienePeriodoVigente">
                Mostrando solo tu período vigente:
                <strong>{{ fechaCorta(resumen.vigenteDesde) }} al {{ fechaCorta(resumen.venceEl) }}</strong>
                <span v-if="resumen.plan"> · {{ resumen.plan }}</span>.
                <div class="small mt-1">
                    Utilizaciones en este período:
                    <strong>{{ resumen.utilizadas }}</strong>
                    <span v-if="!resumen.ilimitado && resumen.permitidas != null">de {{ resumen.permitidas }}</span>
                    <span v-else>(plan ilimitado)</span>
                </div>
            </template>
            <template v-else>
                No tenés un período vigente en este momento.
                <span v-if="resumen && resumen.motivo">{{ resumen.motivo }}</span>
            </template>
        </div>

        <button type="button" class="btn btn-sm btn-outline-primary"
                v-on:click="verHistorialCompleto" v-bind:disabled="cargando">
            Ver historial completo
        </button>
    </div>

    <div v-else-if="esSocio" v-cloak
         class="alert alert-secondary d-flex flex-wrap align-items-center gap-3">
        <i class="bi bi-funnel fs-4"></i>
        <div class="flex-grow-1">
            {{ filtros.desde || filtros.hasta
                ? 'Mostrando los ingresos según las fechas elegidas.'
                : 'Mostrando todo tu historial.' }}
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary"
                v-on:click="limpiarFiltros" v-bind:disabled="cargando">
            Volver a mi período vigente
        </button>
    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Ingresos registrados</h5>
                <span class="badge text-bg-secondary" v-if="esSocio || buscado">
                    Total: {{ total }}
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y hora</th>
                            <th v-if="!esSocio">Socio</th>
                            <th v-if="!esSocio">DNI</th>
                            <th>Tipo</th>
                            <th>Clase</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr v-for="item in asistencias" v-bind:key="item.idAsistencia">
                            <td>{{ formatearFechaHora(item.fechaHoraIngreso) }}</td>

                            <td v-if="!esSocio">
                                {{ item.socio
                                    ? item.socio.apellido + ', ' + item.socio.nombre
                                    : 'Socio #' + item.idSocio }}
                            </td>

                            <td v-if="!esSocio">{{ item.socio ? item.socio.dni : '-' }}</td>

                            <td>
                                <span class="badge"
                                      v-bind:class="item.tipo === 1
                                        ? 'text-bg-info'
                                        : 'text-bg-primary'">
                                    {{ item.tipo === 1 ? 'Clase' : 'Musculación' }}
                                </span>
                            </td>

                            <td>
                                <template v-if="item.idClase">
                                    {{ item.clase && item.clase.actividad
                                        ? item.clase.actividad.nombre
                                        : 'Clase #' + item.idClase }}
                                </template>
                                <span v-else class="text-muted">No corresponde</span>
                            </td>
                        </tr>

                        <tr v-if="!cargando && asistencias.length === 0">
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                {{ !esSocio && !buscado
                                    ? 'Buscá por DNI y/o fechas para ver las asistencias.'
                                    : esSocio && modoPeriodo
                                        ? 'Todavía no registraste ingresos en tu período vigente.'
                                        : 'No hay asistencias para los filtros seleccionados.' }}
                            </td>
                        </tr>

                        <tr v-if="cargando">
                            <td colspan="5" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Cargando asistencias...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div v-if="esSocio || buscado"
                 class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <span class="text-muted small">
                    Página {{ pagina }} de {{ totalPaginas }}
                </span>

                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-outline-secondary btn-sm"
                            v-on:click="irPagina(pagina - 1)"
                            v-bind:disabled="pagina <= 1 || cargando">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </button>

                    <button class="btn btn-outline-secondary btn-sm"
                            v-on:click="irPagina(pagina + 1)"
                            v-bind:disabled="pagina >= totalPaginas || cargando">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        Vue.createApp({
            data() {
                return {
                    esSocio: @(esSocio ? "true" : "false"),
                    asistencias: [],
                    total: 0,
                    pagina: 1,
                    tamPagina: 10,
                    totalPaginas: 1,
                    cargando: false,
                    mensaje: '',
                    error: false,
                    token: '',
                    resumen: null,

                    // Administrador: no se carga nada hasta que busca.
                    buscado: false,

                    // Socio: por defecto solo el período vigente.
                    // Con ?todo=1 (o el botón) se ve el historial completo.
                    verTodo: new URLSearchParams(window.location.search).get('todo') === '1',

                    filtros: {
                        desde: '',
                        hasta: '',
                        dni: ''
                    }
                };
            },

            computed: {
                // Período vigente = el socio no pidió ver todo ni eligió fechas.
                modoPeriodo() {
                    return this.esSocio &&
                        !this.verTodo &&
                        !this.filtros.desde &&
                        !this.filtros.hasta;
                }
            },

           async mounted() {
            await this.obtenerToken();

            // El socio ve su período vigente al entrar.
            // El administrador no: tiene que buscar por DNI y/o fechas.
            if (this.token && this.esSocio) {
                await this.buscar();
            }
        },

            methods: {
                async buscar() {
                    if (this.filtros.desde && this.filtros.hasta &&
                        this.filtros.desde > this.filtros.hasta) {
                        this.mensaje = 'La fecha inicial no puede ser posterior a la fecha final.';
                        this.error = true;
                        return;
                    }

                    if (!this.esSocio) {
                        const dni = (this.filtros.dni || '').trim();

                        if (!dni && !this.filtros.desde && !this.filtros.hasta) {
                            this.mensaje = 'Ingresá un DNI y/o un rango de fechas para buscar.';
                            this.error = false;
                            return;
                        }

                        if (dni && !/^\d{7,10}$/.test(dni)) {
                            this.mensaje = 'Ingresá un DNI válido de entre 7 y 10 dígitos.';
                            this.error = true;
                            return;
                        }
                    }

                    this.cargando = true;
                    this.buscado = true;
                    this.mensaje = '';
                    this.error = false;

                    const params = new URLSearchParams({
                        pagina: this.pagina,
                        tamPagina: this.tamPagina
                    });

                    if (this.filtros.desde)
                        params.set('desde', this.filtros.desde);

                    if (this.filtros.hasta)
                        params.set('hasta', this.filtros.hasta);

                    if (this.esSocio) {
                        // Por defecto solo el período vigente. Si el socio eligió
                        // fechas o "ver historial completo", se busca sin limitar.
                        params.set('periodoActual', this.modoPeriodo ? 'true' : 'false');
                    } else if (this.filtros.dni) {
                        // El socio nunca manda un DNI: la API lo toma de su sesión
                        params.set('dni', this.filtros.dni.trim());
                    }

                    const url = this.esSocio
                        ? '/api/asistencias/mia'
                        : '/api/asistencias';

                    try {
                        const response = await fetch(
    `${url}?${params.toString()}`,
    {
        headers: {
            'Accept': 'application/json',
            'Authorization': `Bearer ${this.token}`
        },
        credentials: 'same-origin'
    }
);

                        const texto = await response.text();
                        let data = {};

                        try {
                            data = texto ? JSON.parse(texto) : {};
                        } catch {
                            throw new Error(
                                'El servidor devolvió una respuesta inesperada.'
                            );
                        }

                        if (!response.ok) {
                            if (response.status === 401 || response.status === 403) {
                                throw new Error(
                                    'Necesitás iniciar sesión con un rol autorizado para consultar el historial.'
                                );
                            }

                            throw new Error(
                                data.mensaje || 'No se pudo cargar el historial.'
                            );
                        }

                        this.asistencias = data.items || [];
                        this.total = data.total || 0;
                        this.resumen = data.resumen || null;
                        this.pagina = data.pagina || this.pagina;
                        this.tamPagina = data.tamPagina || this.tamPagina;
                        this.totalPaginas = Math.max(
                            1,
                            Math.ceil(this.total / this.tamPagina)
                        );
                    } catch (e) {
                        this.asistencias = [];
                        this.total = 0;
                        this.totalPaginas = 1;
                        this.mensaje = e.message;
                        this.error = true;
                    } finally {
                        this.cargando = false;
                    }
                },

                irPagina(numero) {
                    if (numero < 1 || numero > this.totalPaginas) return;
                    this.pagina = numero;
                    this.buscar();
                },

                nuevaBusqueda() {
                    this.pagina = 1;
                    this.buscar();
                },

                // Para el socio, limpiar vuelve a la vista por defecto: el período vigente.
                limpiarFiltros() {
                    this.filtros = {
                        desde: '',
                        hasta: '',
                        dni: ''
                    };
                    this.verTodo = false;
                    this.pagina = 1;

                    if (!this.esSocio) {
                        // Administrador: vuelve a la pantalla sin resultados.
                        this.asistencias = [];
                        this.total = 0;
                        this.totalPaginas = 1;
                        this.buscado = false;
                        this.mensaje = '';
                        this.error = false;
                        return;
                    }

                    this.buscar();
                },

                verHistorialCompleto() {
                    this.filtros.desde = '';
                    this.filtros.hasta = '';
                    this.verTodo = true;
                    this.pagina = 1;
                    this.buscar();
                },

                fechaCorta(fecha) {
                    if (!fecha) return '-';

                    const valor = new Date(fecha);

                    return Number.isNaN(valor.getTime())
                        ? '-'
                        : valor.toLocaleDateString('es-AR');
                },

                formatearFechaHora(fecha) {
                    if (!fecha) return '-';

                    const valor = new Date(fecha);

                    if (Number.isNaN(valor.getTime())) return '-';

                    return valor.toLocaleString('es-AR');
                },

                async obtenerToken() {
    try {
        const respuesta = await fetch('/Cuenta/Token', {
            credentials: 'same-origin'
        });

        if (!respuesta.ok) {
            this.mensaje = 'No se pudo obtener el token. Volvé a iniciar sesión.';
            this.error = true;
            return;
        }

        const datos = await respuesta.json();
        this.token = datos.token;
    } catch (e) {
        this.mensaje = 'No se pudo conectar con el servidor.';
        this.error = true;
    }
},
            },

            watch: {
                tamPagina() {
                    if (!this.esSocio && !this.buscado) return;

                    this.pagina = 1;
                    this.buscar();
                }
            }
        }).mount('#appHistorial');
    </script>
}