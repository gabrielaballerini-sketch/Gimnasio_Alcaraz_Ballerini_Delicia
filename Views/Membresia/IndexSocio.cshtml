@{
    ViewData["Title"] = "Mi membresía";
}

<div id="app" class="mt-4">

    <!-- AVISOS -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div v-if="aviso.texto" v-cloak
             class="toast show text-white border-0 bg-danger">
            <div class="d-flex">
                <div class="toast-body">{{ aviso.texto }}</div>
                <button class="btn-close btn-close-white me-2 m-auto"
                        v-on:click="aviso.texto = ''"></button>
            </div>
        </div>
    </div>

    <h2 class="mb-4">Mi membresía</h2>

    <div v-if="cargando" class="text-center text-muted py-5">Cargando...</div>

    <div v-else-if="sinFicha" class="alert alert-warning">
        Tu usuario todavía no tiene una ficha de socio asociada. Consultá en recepción.
    </div>

    <div v-else-if="!principal" class="alert alert-light border">
        Todavía no tenés ninguna membresía registrada. Consultá en recepción por los planes disponibles.
    </div>

    <template v-else>

        <!-- MEMBRESÍA PRINCIPAL -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    {{ principal.estadoVigencia === 'vencida' ? 'Última membresía' : 'Membresía actual' }}
                </h5>
                <span class="badge" v-bind:class="'bg-' + principal.color">
                    {{ principal.etiqueta }}
                </span>
            </div>

            <div class="card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="text-muted small">Plan</div>
                        <div class="fs-4 fw-semibold mb-3">{{ principal.plan.nombre }}</div>

                        <div class="row">
                            <div class="col-6">
                                <div class="text-muted small">Inicio</div>
                                <div>{{ fecha(principal.fechaInicio) }}</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Vencimiento</div>
                                <div class="fw-semibold">{{ fecha(principal.fechaFin) }}</div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-6">
                                <div class="text-muted small">Utilizaciones</div>
                                <div>
                                    <span v-if="principal.plan.utilizacionesMensuales === null">Ilimitadas</span>
                                    <span v-else>{{ principal.plan.utilizacionesMensuales }} por mes</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Precio contratado</div>
                                <div>{{ precio(principal.precioContratado) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">{{ principal.titulo }}</div>
                        <div class="display-5 fw-semibold" v-bind:class="'text-' + principal.color">
                            {{ principal.grande }}
                        </div>
                        <div class="text-muted mb-3">{{ principal.detalle }}</div>

                        <div class="progress" style="height:10px"
                             v-if="principal.estadoVigencia !== 'proxima' && principal.estadoVigencia !== 'pendiente'">
                            <div class="progress-bar"
                                 v-bind:class="'bg-' + principal.color"
                                 v-bind:style="{ width: principal.porcentaje + '%' }"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- HISTORIAL -->
        <div class="card" v-if="membresias.length > 1">
            <div class="card-header bg-white">Historial</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Plan</th>
                            <th>Inicio</th>
                            <th>Vencimiento</th>
                            <th>Precio</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="m in membresias" v-bind:key="m.idMembresia">
                            <td>{{ m.plan.nombre }}</td>
                            <td>{{ fecha(m.fechaInicio) }}</td>
                            <td>{{ fecha(m.fechaFin) }}</td>
                            <td>{{ precio(m.precioContratado) }}</td>
                            <td>
                                <span class="badge" v-bind:class="'bg-' + m.color">{{ m.etiqueta }}</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </template>

</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const DIA = 24 * 60 * 60 * 1000;

        // Fecha de hoy a las 00:00 (las fechas de la API vienen sin hora)
        function hoySinHora() {
            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);
            return hoy;
        }

        // Agrega a cada membresía su estado de vigencia y los textos para mostrar
        function calcular(m) {
            const hoy = hoySinHora();
            const inicio = new Date(m.fechaInicio);
            const fin = new Date(m.fechaFin);
            const diasRestantes = Math.round((fin - hoy) / DIA);

            const total = Math.max(fin - inicio, DIA);
            const porcentaje = Math.min(100, Math.max(0, ((hoy - inicio) / total) * 100));

            let r;

            if (!m.pagada) {
                // Recién creada o sin pagar: todavía no tiene período habilitado.
                r = {
                    estadoVigencia: 'pendiente', color: 'warning', etiqueta: 'Pendiente de pago',
                    titulo: 'Estado', grande: 'Sin pagar',
                    detalle: 'Se habilita cuando se registre el pago en recepción'
                };
            } else if (inicio > hoy) {
                const diasParaInicio = Math.round((inicio - hoy) / DIA);
                r = {
                    estadoVigencia: 'proxima', color: 'info', etiqueta: 'Próxima',
                    titulo: 'Comienza en', grande: `${diasParaInicio} día${diasParaInicio === 1 ? '' : 's'}`,
                    detalle: 'Todavía no empezó'
                };
            } else if (fin < hoy) {
                const hace = Math.abs(diasRestantes);
                r = {
                    estadoVigencia: 'vencida', color: 'danger', etiqueta: 'Vencida',
                    titulo: 'Venció hace', grande: `${hace} día${hace === 1 ? '' : 's'}`,
                    detalle: 'Consultá en recepción para renovarla'
                };
            } else if (diasRestantes <= 7) {
                r = {
                    estadoVigencia: 'por-vencer', color: 'warning', etiqueta: 'Por vencer',
                    titulo: 'Te quedan',
                    grande: diasRestantes === 0 ? 'Vence hoy' : `${diasRestantes} día${diasRestantes === 1 ? '' : 's'}`,
                    detalle: 'Renovala a tiempo para no perder tu acceso'
                };
            } else {
                r = {
                    estadoVigencia: 'vigente', color: 'success', etiqueta: 'Vigente',
                    titulo: 'Te quedan', grande: `${diasRestantes} días`,
                    detalle: 'Tu membresía está al día'
                };
            }

            return { ...m, ...r, porcentaje };
        }

        Vue.createApp({
            data() {
                return {
                    membresias: [],
                    principal: null,
                    sinFicha: false,
                    cargando: true,
                    aviso: { texto: '' },
                    temporizadorAviso: null,
                    token: ''
                };
            },

            async mounted() {
                await this.iniciar();
            },

            methods: {
                async iniciar() {
                    try {
                        const resp = await fetch('/Cuenta/Token', {
                            credentials: 'same-origin'
                        });

                        if (!resp.ok) {
                            this.mostrarAviso('Volvé a iniciar sesión.');
                            this.cargando = false;
                            return;
                        }

                        const datos = await resp.json();
                        this.token = datos.token;

                        await this.cargar();
                    } catch (error) {
                        this.mostrarAviso('No se pudo conectar con el servidor.');
                    } finally {
                        this.cargando = false;
                    }
                },

                async peticionApi(url) {
                    const headers = new Headers();
                    headers.set('Authorization', `Bearer ${this.token}`);

                    return fetch(url, { headers, credentials: 'same-origin' });
                },

                mostrarAviso(texto) {
                    this.aviso = { texto };

                    clearTimeout(this.temporizadorAviso);

                    this.temporizadorAviso = setTimeout(() => {
                        this.aviso.texto = '';
                    }, 5000);
                },

                fecha(valor) {
                    return new Date(valor).toLocaleDateString('es-AR');
                },

                precio(valor) {
                    return Number(valor).toLocaleString('es-AR', {
                        style: 'currency',
                        currency: 'ARS'
                    });
                },

                async cargar() {
                    const resp = await this.peticionApi('/api/membresias/mia');

                    if (resp.status === 404) {
                        this.sinFicha = true;
                        return;
                    }

                    if (!resp.ok) {
                        this.mostrarAviso('No se pudo cargar tu membresía.');
                        return;
                    }

                    const lista = (await resp.json()).map(calcular);

                    this.membresias = lista;

                    // Principal: la vigente; si no hay, la próxima; si no, la que venció más recientemente
                    this.principal =
                        lista.find(m => m.estadoVigencia === 'vigente' || m.estadoVigencia === 'por-vencer')
                        ?? lista.find(m => m.estadoVigencia === 'proxima')
                        ?? [...lista].sort((a, b) => new Date(b.fechaFin) - new Date(a.fechaFin))[0]
                        ?? null;
                }
            }
        }).mount('#app');
    </script>
}
