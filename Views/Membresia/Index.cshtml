@{
    ViewData["Title"] = "Membresías";
}

<div class="container mt-4" id="app">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Membresías</h1>
            <p class="text-muted mb-0">
                Administración de las membresías de los socios.
            </p>
        </div>

        <button class="btn btn-primary" @@click="abrirCrear">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva membresía
        </button>
    </div>

    <div v-if="mensaje" v-cloak class="alert alert-success alert-dismissible fade show">
        {{ mensaje }}
        <button type="button" class="btn-close" @@click="mensaje = ''"></button>
    </div>

    <div v-if="error" v-cloak class="alert alert-danger alert-dismissible fade show">
        {{ error }}
        <button type="button" class="btn-close" @@click="error = ''"></button>
    </div>

    <ul class="nav nav-tabs mb-3">

        <li class="nav-item">
            <button class="nav-link" :class="{ active: mostrarActivos }" @@click="cambiarPestania(true)">
                Activas
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link" :class="{ active: !mostrarActivos }" @@click="cambiarPestania(false)">
                Inactivas
            </button>
        </li>

    </ul>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div v-if="cargando" class="text-center py-4">
                <div class="spinner-border" role="status">
                </div>

                <p class="mt-2 mb-0">
                    Cargando...
                </p>
            </div>

            <div v-else-if="membresias.length === 0" class="text-center text-muted py-5">

                <i class="bi bi-card-list fs-1"></i>

                <p class="mt-3 mb-0">
                    No hay membresías para mostrar.
                </p>

            </div>

            <div v-else class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Socio</th>
                            <th>DNI</th>
                            <th>Plan</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Precio</th>
                            <th>Pago</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr v-for="m in membresias" :key="m.idMembresia">

                            <td>
                                <strong>
                                    {{ m.socio?.nombre }}
                                    {{ m.socio?.apellido }}
                                </strong>
                            </td>

                            <td>
                                {{ m.socio?.dni }}
                            </td>

                            <td>
                                {{ m.plan?.nombre }}
                            </td>

                            <td>
                                {{ formatearFecha(m.fechaInicio) }}
                            </td>

                            <td>
                                {{ formatearFecha(m.fechaFin) }}
                            </td>

                            <td>
                                $ {{ formatearPrecio(m.precioContratado) }}
                            </td>

                            <td>
                                <span class="badge" :class="estadoPago(m).clase">
                                    {{ estadoPago(m).texto }}
                                </span>
                            </td>

                            <td class="text-end">

                                <button v-if="mostrarActivos && requiereCobro(m)"
                                    class="btn btn-sm btn-success me-1" title="Registrar pago"
                                    @@click="cobrar(m)">
                                    <i class="bi bi-cash-coin"></i> Cobrar
                                </button>

                                <button v-if="mostrarActivos" class="btn btn-sm btn-outline-primary me-1"
                                    @@click="editar(m)">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button v-if="mostrarActivos" class="btn btn-sm btn-outline-danger"
                                    @@click="pedirBaja(m)">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <button v-else class="btn btn-sm btn-outline-success" @@click="reactivar(m)">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

            <div v-if="totalPaginas > 1" class="d-flex justify-content-center mt-3">

                <nav>

                    <ul class="pagination">

                        <li class="page-item" :class="{ disabled: pagina === 1 }">

                            <button class="page-link" @@click="cambiarPagina(pagina - 1)">
                                Anterior
                            </button>

                        </li>

                        <li v-for="n in totalPaginas" :key="n" class="page-item" :class="{ active: pagina === n }">

                            <button class="page-link" @@click="cambiarPagina(n)">
                                {{ n }}
                            </button>

                        </li>

                        <li class="page-item" :class="{ disabled: pagina === totalPaginas }">

                            <button class="page-link" @@click="cambiarPagina(pagina + 1)">
                                Siguiente
                            </button>

                        </li>

                    </ul>

                </nav>

            </div>

        </div>

    </div>

    <!-- MODAL CREAR / EDITAR -->

    <div class="modal fade" id="modalMembresia" tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        {{ editando
                        ? 'Modificar membresía'
                        : 'Nueva membresía' }}
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div v-if="errorModal" v-cloak class="alert alert-danger">
                        {{ errorModal }}
                    </div>

                    <div class="mb-3">

                      
                        <div class="mb-3">

                            <label class="form-label">
                                Socio
                            </label>

                            <!-- Socio ya elegido -->
                            <div v-if="socioSeleccionado"
                                 class="d-flex align-items-center justify-content-between border rounded p-2">

                                <div class="d-flex align-items-center">

                                    <img v-if="socioSeleccionado.avatar" :src="socioSeleccionado.avatar"
                                         class="rounded-circle me-2" style="width:36px;height:36px;object-fit:cover" />

                                    <div>
                                        <div class="fw-semibold">
                                            {{ socioSeleccionado.apellido }}, {{ socioSeleccionado.nombre }}
                                        </div>
                                        <small class="text-muted">
                                            DNI {{ socioSeleccionado.dni }}
                                        </small>
                                    </div>

                                </div>

                                <button type="button" class="btn btn-sm btn-outline-secondary" @@click="quitarSocio">
                                    Cambiar
                                </button>

                            </div>

                            <!-- Buscador -->
                            <div v-else class="position-relative">

                                <input type="text" class="form-control" placeholder="Buscar por nombre, apellido..."
                                       autocomplete="off" v-model="busquedaSocio" @@input="buscarSocios" />

                                <div v-if="busquedaSocio.trim().length >= 2"
                                     class="list-group position-absolute w-100 shadow-sm"
                                     style="z-index:1056;max-height:240px;overflow-y:auto">

                                    <div v-if="buscandoSocios" class="list-group-item text-muted">
                                        Buscando...
                                    </div>

                                    <template v-else>

                                        <button v-for="s in resultadosSocios" :key="s.idSocio" type="button"
                                                class="list-group-item list-group-item-action" @@click="elegirSocio(s)">

                                            <strong>{{ s.apellido }}, {{ s.nombre }}</strong>
                                            <small class="text-muted ms-2">DNI {{ s.dni }}</small>

                                        </button>

                                        <div v-if="resultadosSocios.length === 0" class="list-group-item text-muted">
                                            No se encontraron socios activos.
                                        </div>

                                    </template>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Plan
                        </label>

                        <select class="form-select" v-model="form.idPlan" @@change="actualizarPrecio">

                            <option value="0">
                                Seleccione un plan
                            </option>

                            <option v-for="p in planes" :key="p.idPlan" :value="p.idPlan">

                                {{ p.nombre }}
                                - ${{ formatearPrecio(p.precio) }}

                            </option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Fecha de inicio
                        </label>

                        <input type="date" class="form-control" v-model="form.fechaInicio"
                               :min="editando ? null : fechaMinima" :disabled="editando" />

                        <small v-if="editando" class="text-muted">
                            La vigencia no se edita: se define al registrar el pago.
                            Si cambiás el plan, el período queda pendiente de pago.
                        </small>
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Precio mensual contratado
                        </label>

                        <input type="text" class="form-control" :value="precioSeleccionadoTexto" readonly />

                        <small class="text-muted">
                            El precio queda guardado en la membresía
                            aunque posteriormente cambie el precio del plan.
                        </small>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button" class="btn btn-primary" @@click="guardar">
                        Guardar
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL DE CONFIRMACIÓN (baja) -->
    <div class="modal fade" tabindex="-1" ref="modalConfirmar">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">

                    <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center fs-2 bg-danger-subtle text-danger"
                         style="width:64px;height:64px">
                        !
                    </div>

                    <h5 class="mb-2">{{ confirmacion.titulo }}</h5>
                    <p class="text-muted mb-3">{{ confirmacion.mensaje }}</p>

                    <div v-if="confirmacion.membresia" class="bg-light rounded p-2 mb-3">
                        <div class="fw-semibold">
                            {{ confirmacion.membresia.socio?.apellido }}, {{ confirmacion.membresia.socio?.nombre }}
                        </div>
                        <small class="text-muted">{{ confirmacion.membresia.plan?.nombre }}</small>
                    </div>

                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-danger px-4"
                                @@click="confirmar">{{ confirmacion.textoBoton }}</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- MODAL DE PAGO INICIAL: forma parte de esta misma vista Index.cshtml -->
    <div class="modal fade" id="modalPagoInicial" tabindex="-1"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar pago de membresía</h5>
                </div>
                <div class="modal-body">
                    <div v-if="errorPago" v-cloak class="alert alert-danger">
                        {{ errorPago }}
                    </div>
                    <p>Para habilitar la membresía, primero debe registrarse el pago.</p>
                    <div class="mb-3">
                        <label class="form-label">Importe a cobrar</label>
                        <input type="text" class="form-control"
                               :value="'$ ' + formatearPrecio(importePago)" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Medio de pago</label>
                        <select class="form-select" v-model="medioPago">
                            <option value="1">Efectivo</option>
                            <option value="2">Débito</option>
                            <option value="3">Crédito</option>
                            <option value="4">Transferencia</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary"
                        @@click="cobrarDespues"
                        :disabled="procesandoPago">
                        Cobrar después
                  </button>
                    <button type="button" class="btn btn-primary"
                            @@click="confirmarPago" :disabled="procesandoPago">
                        {{ procesandoPago ? 'Registrando pago...' : 'Confirmar pago' }}
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {

    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

    <script>

        const API = '/api/membresias';

        const { createApp } = Vue;

        createApp({

            data() {

                return {

                    token: '',

                    membresias: [],
                    busquedaSocio: '',
                    resultadosSocios: [],
                    buscandoSocios: false,
                    socioSeleccionado: null,
                    temporizadorBusqueda: null,
                    planes: [],
                    pagina: 1,
                    tamPagina: 10,
                    total: 0,
                    totalPaginas: 0,
                    mostrarActivos: true,
                    cargando: false,
                    mensaje: '',
                    error: '',
                    errorModal: '',
                    idMembresiaPago: null,
                    importePago: 0,
                    medioPago: '1',
                    errorPago: '',
                    procesandoPago: false,
                    modalConfirmar: null,
                    confirmacion: {
                        titulo: '',
                        mensaje: '',
                        textoBoton: '',
                        membresia: null,
                        accion: null
                    },
                    editando: false,
                    idEditando: null,
                    form: {
                        idSocio: 0,
                        idPlan: 0,
                        fechaInicio: ''
                    }
                };
            },
            computed: {
                fechaMinima() {
                    const h = new Date();
                    const mes = String(h.getMonth() + 1).padStart(2, '0');
                    const dia = String(h.getDate()).padStart(2, '0');
                    return `${h.getFullYear()}-${mes}-${dia}`;
                },
                precioSeleccionado() {
                    const plan =
                        this.planes.find(
                            p => Number(p.idPlan) ===
                                Number(this.form.idPlan)
                        );
                    return plan
                        ? plan.precio
                        : 0;
                },
                precioSeleccionadoTexto() {
                    if (!this.precioSeleccionado)
                        return '';

                    return '$ ' +
                        this.formatearPrecio(
                            this.precioSeleccionado
                        );
                }
            },
            async mounted() {
                this.modalConfirmar = new bootstrap.Modal(this.$refs.modalConfirmar);

                await this.iniciar();
            },
            methods: {

                // ---------- Token JWT ----------
                async iniciar() {

                    try {

                        const resp = await fetch(
                            '/Cuenta/Token',
                            { credentials: 'same-origin' }
                        );

                        if (!resp.ok) {
                            this.error = 'No se pudo obtener el token. Volvé a iniciar sesión.';
                            return;
                        }

                        const datos = await resp.json();

                        this.token = datos.token;

                        await this.cargarDatos();

                    }
                    catch (e) {
                        this.error = 'No se pudo conectar con el servidor.';
                    }

                },


                // Todas las llamadas a la API llevan el JWT
                async peticionApi(url, opciones = {}) {

                    const headers = new Headers(opciones.headers || {});

                    headers.set('Authorization', `Bearer ${this.token}`);

                    return fetch(url, {
                        ...opciones,
                        headers,
                        credentials: 'same-origin'
                    });

                },

                async cargarDatos() {
                    await Promise.all([
                        this.cargarPlanes(),
                        this.cargarMembresias()
                    ]);

                },

                async cargarMembresias() {
                    this.cargando = true;
                    this.error = '';
                    try {
                        const endpoint =
                            this.mostrarActivos
                                ? `${API}/activos`
                                : `${API}/inactivos`;

                        const response =
                            await this.peticionApi(
                                `${endpoint}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`
                            );

                        if (!response.ok)
                            throw new Error(
                                'No se pudieron cargar las membresías.'
                            );

                        const data =
                            await response.json();

                        this.membresias =
                            data.items ?? [];

                        this.total =
                            data.total ?? 0;

                        this.totalPaginas =
                            Math.ceil(
                                this.total /
                                this.tamPagina
                            );
                    }
                    catch (e) { this.error = e.message; }
                    finally {

                        this.cargando = false;
                    }

                },

                buscarSocios() {

                    clearTimeout(this.temporizadorBusqueda);

                    const texto = this.busquedaSocio.trim();

                    if (texto.length < 2) {
                        this.resultadosSocios = [];
                        this.buscandoSocios = false;
                        return;
                    }

                    this.buscandoSocios = true;

                    // Espera 300 ms sin tipear para no consultar en cada tecla
                    this.temporizadorBusqueda = setTimeout(async () => {

                        try {

                            const response = await this.peticionApi(
                                `/api/socios/buscar?texto=${encodeURIComponent(texto)}`
                            );

                            if (!response.ok)
                                throw new Error('No se pudo buscar socios.');

                            const datos = await response.json();

                            // Si el usuario siguió escribiendo, esta respuesta quedó vieja
                            if (texto !== this.busquedaSocio.trim())
                                return;

                            this.resultadosSocios = datos;
                            this.buscandoSocios = false;

                        }
                        catch (e) {

                            this.errorModal = e.message;
                            this.buscandoSocios = false;

                        }

                    }, 300);

                },

                elegirSocio(socio) {

                    this.socioSeleccionado = socio;
                    this.form.idSocio = socio.idSocio;
                    this.busquedaSocio = '';
                    this.resultadosSocios = [];

                },

                quitarSocio() {

                    this.socioSeleccionado = null;
                    this.form.idSocio = 0;
                    this.busquedaSocio = '';
                    this.resultadosSocios = [];

                },

                async cargarPlanes() {

                    try {

                        const response =
                            await this.peticionApi(
                                '/api/planes/activos?pagina=1&tamPagina=20'
                            );

                        if (!response.ok)
                            throw new Error(
                                'No se pudieron cargar los planes.'
                            );

                        const data =
                            await response.json();

                        this.planes =
                            data.items ?? [];

                    }
                    catch (e) {

                        this.error =
                            e.message;

                    }

                },

                abrirCrear() {

                    this.editando = false;

                    this.idEditando = null;

                    this.errorModal = '';
                    this.socioSeleccionado = null;
                    this.busquedaSocio = '';
                    this.resultadosSocios = [];

                    this.form = {

                        idSocio: 0,

                        idPlan: 0,

                        fechaInicio:
                            this.fechaMinima

                    };

                    const modal =
                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById(
                                'modalMembresia'
                            )
                        );

                    modal.show();

                },

                editar(m) {

                    this.editando = true;

                    this.idEditando =
                        m.idMembresia;

                    this.errorModal = '';
                    this.socioSeleccionado = m.socio ?? null;
                    this.busquedaSocio = '';
                    this.resultadosSocios = [];

                    this.form = {

                        idSocio:
                            m.idSocio,

                        idPlan:
                            m.idPlan,

                        fechaInicio:
                            m.fechaInicio
                                ? m.fechaInicio.substring(0, 10)
                                : ''

                    };

                    const modal =
                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById(
                                'modalMembresia'
                            )
                        );

                    modal.show();

                },

                // Una membresía está pagada y vigente solo si Pagada = true
                // y la fecha de hoy cae dentro de su período.
                requiereCobro(m) {
                    if (!m.pagada) return true;
                    const fin = (m.fechaFin || '').substring(0, 10);
                    return fin < this.fechaMinima;
                },

                estadoPago(m) {
                    if (!m.pagada)
                        return { texto: 'Pendiente de pago', clase: 'bg-warning text-dark' };
                    if (this.requiereCobro(m))
                        return { texto: 'Vencida', clase: 'bg-danger' };
                    return { texto: 'Pagada', clase: 'bg-success' };
                },

                // Abre el mismo modal de pago que aparece al crear la membresía.
                cobrar(m) {
                    this.idMembresiaPago = m.idMembresia;
                    // Renovación (ya pagada y vencida): precio actual del plan.
                    // Primer pago o período pendiente: precio contratado.
                    this.importePago = Number(
                        m.pagada ? (m.plan?.precio ?? m.precioContratado) : m.precioContratado
                    ) || 0;
                    this.medioPago = '1';
                    this.errorPago = '';

                    bootstrap.Modal.getOrCreateInstance(
                        document.getElementById('modalPagoInicial')
                    ).show();
                },

                actualizarPrecio() {

                    // El precio se obtiene automáticamente
                    // desde el plan seleccionado.

                },

                async guardar() {
                    this.errorModal = '';

                    if (!this.form.idSocio || Number(this.form.idSocio) <= 0) {
                        this.errorModal = 'Debe seleccionar un socio.';
                        return;
                    }

                    if (!this.form.idPlan || Number(this.form.idPlan) <= 0) {
                        this.errorModal = 'Debe seleccionar un plan.';
                        return;
                    }

                    if (!this.editando && !this.form.fechaInicio) {
                        this.errorModal = 'Debe seleccionar una fecha de inicio.';
                        return;
                    }

                    const formData = new FormData();
                    formData.append('IdSocio', this.form.idSocio);
                    formData.append('IdPlan', this.form.idPlan);
                    formData.append('FechaInicio', this.form.fechaInicio);
                    formData.append('FechaFin', this.form.fechaInicio);
                    formData.append('PrecioContratado', this.precioSeleccionado);

                    let response;

                    try {
                        if (this.editando) {
                            response = await this.peticionApi(
                                `${API}/${this.idEditando}`,
                                { method: 'PUT', body: formData }
                            );
                        } else {
                            response = await this.peticionApi(
                                API,
                                { method: 'POST', body: formData }
                            );
                        }

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) {
                            this.errorModal = data.mensaje ||
                                'No se pudo guardar la membresía.';
                            return;
                        }

                        // Si editamos, no cobramos automáticamente.
                        if (this.editando) {
                            bootstrap.Modal.getInstance(
                                document.getElementById('modalMembresia')
                            )?.hide();

                            this.mensaje = 'Membresía modificada correctamente.';
                            await this.cargarMembresias();
                            return;
                        }

                        // El POST devuelve la membresía creada, con su ID real.
                        const idMembresia = data.idMembresia ?? data.IdMembresia;

                        if (!idMembresia) {
                            this.errorModal =
                                'El servidor no devolvió el ID de la membresía. Revisá la lista antes de volver a crearla.';
                            return;
                        }

                        bootstrap.Modal.getInstance(
                            document.getElementById('modalMembresia')
                        )?.hide();

                        this.idMembresiaPago = idMembresia;
                        this.importePago = Number(
                            data.precioContratado ?? data.PrecioContratado
                        ) || Number(this.precioSeleccionado) || 0;
                        this.medioPago = '1';
                        this.errorPago = '';

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('modalPagoInicial')
                        ).show();
                    }
                    catch (e) {
                        this.errorModal =
                            'No se pudo conectar con el servidor. Verificá si la membresía se creó antes de volver a intentarlo.';
                    }
                },

                async cobrarDespues() {
                    bootstrap.Modal.getInstance(
                        document.getElementById('modalPagoInicial')
                    )?.hide();

                    this.idMembresiaPago = null;
                    this.importePago = 0;

                    this.mensaje = 'La membresía se registró correctamente. El pago quedó pendiente.';

                    await this.cargarMembresias();
                },

                async confirmarPago() {
                    this.errorPago = '';

                    if (!this.idMembresiaPago) {
                        this.errorPago = 'No se identificó la membresía que se debe cobrar.';
                        return;
                    }

                    this.procesandoPago = true;

                    try {
                        const response = await this.peticionApi(
                            `/api/pagos/membresia/${this.idMembresiaPago}`,
                            {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    medioPago: Number(this.medioPago)
                                })
                            }
                        );

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok) {
                            this.errorPago = data.mensaje ||
                                'No se pudo registrar el pago.';
                            return;
                        }

                        bootstrap.Modal.getInstance(
                            document.getElementById('modalPagoInicial')
                        )?.hide();

                        this.mensaje = 'Pago registrado correctamente. La membresía quedó habilitada.';
                        this.idMembresiaPago = null;
                        this.importePago = 0;
                        await this.cargarMembresias();
                    }
                    catch (e) {
                        this.errorPago =
                            'No se pudo conectar con el servidor. Antes de volver a intentar, comprobá si el pago quedó registrado.';
                    }
                    finally {
                        this.procesandoPago = false;
                    }
                },

                // ---------- Confirmación de baja ----------
                pedirBaja(m) {
                    this.confirmacion = {
                        titulo: 'Dar de baja la membresía',
                        mensaje: 'Pasará a la lista de inactivas y el socio no podrá ingresar. Podés reactivarla cuando quieras.',
                        textoBoton: 'Dar de baja',
                        membresia: m,
                        accion: () => this.ejecutarBaja(m)
                    };
                    this.modalConfirmar.show();
                },

                async confirmar() {
                    const accion = this.confirmacion.accion;
                    this.modalConfirmar.hide();
                    if (accion) await accion();
                },

                async ejecutarBaja(m) {

                    const response =
                        await this.peticionApi(
                            `${API}/${m.idMembresia}`,
                            {
                                method: 'DELETE'
                            }
                        );

                    if (!response.ok) {

                        this.error =
                            'No se pudo dar de baja la membresía.';

                        return;

                    }

                    this.mensaje =
                        'Membresía dada de baja correctamente.';

                    await this.cargarMembresias();

                },

                async reactivar(m) {

                    if (!confirm(
                        `¿Desea reactivar esta membresía?`
                    ))
                        return;

                    const response =
                        await this.peticionApi(
                            `${API}/${m.idMembresia}/reactivar`,
                            {
                                method: 'PUT'
                            }
                        );

                    if (!response.ok) {

                        this.error =
                            'No se pudo reactivar la membresía.';

                        return;

                    }

                    this.mensaje =
                        'Membresía reactivada correctamente.';

                    await this.cargarMembresias();

                },

                cambiarPestania(activos) {

                    this.mostrarActivos =
                        activos;

                    this.pagina = 1;

                    this.cargarMembresias();

                },

                cambiarPagina(nuevaPagina) {

                    if (nuevaPagina < 1 ||
                        nuevaPagina > this.totalPaginas)
                        return;

                    this.pagina =
                        nuevaPagina;

                    this.cargarMembresias();

                },

                formatearFecha(fecha) {

                    if (!fecha)
                        return '';

                    return new Date(fecha)
                        .toLocaleDateString(
                            'es-AR'
                        );

                },

                formatearPrecio(precio) {

                    return Number(precio || 0)
                        .toLocaleString(
                            'es-AR',
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                }
            }
        }).mount('#app');

    </script>
}