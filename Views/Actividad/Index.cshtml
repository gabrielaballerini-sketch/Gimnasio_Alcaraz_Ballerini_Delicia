
@{
    ViewData["Title"] = "Actividades";
}

<div id="app" class="mt-4">

    <h2>Actividades</h2>

    <!-- AVISOS -->
    <div class="toast-container position-fixed top-0 end-0 p-3"
         style="z-index:1100">
        <div v-if="aviso.texto" v-cloak
             class="toast show text-white border-0"
             v-bind:class="aviso.tipo === 'ok' ? 'bg-success' : 'bg-danger'">
            <div class="d-flex">
                <div class="toast-body">{{ aviso.texto }}</div>
                <button class="btn-close btn-close-white me-2 m-auto"
                        v-on:click="aviso.texto = ''"></button>
            </div>
        </div>
    </div>

    <!-- MODAL DE BAJA / REACTIVACIÓN -->
    <div class="modal fade" tabindex="-1" ref="modalConfirmar">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">

                    <div class="mx-auto mb-3 rounded-circle d-flex
                                align-items-center justify-content-center fs-2"
                         style="width:64px;height:64px"
                         v-bind:class="confirmacion.tipo === 'danger'
                            ? 'bg-danger-subtle text-danger'
                            : 'bg-success-subtle text-success'">
                        {{ confirmacion.tipo === 'danger' ? '!' : '✓' }}
                    </div>

                    <h5>{{ confirmacion.titulo }}</h5>
                    <p class="text-muted">{{ confirmacion.mensaje }}</p>

                    <div v-if="confirmacion.actividad"
                         class="bg-light rounded p-3 mb-3">
                        <strong>{{ confirmacion.actividad.nombre }}</strong>
                    </div>

                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-light px-4"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button class="btn px-4"
                                v-bind:class="confirmacion.tipo === 'danger'
                                    ? 'btn-danger' : 'btn-success'"
                                v-on:click="confirmar"
                                v-bind:disabled="procesando">
                            {{ procesando ? 'Procesando...' : confirmacion.textoBoton }}
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- FORMULARIO -->
    <div class="card mb-4">
        <div class="card-header">
            {{ form.idActividad ? 'Editar actividad' : 'Nueva actividad' }}
        </div>

        <div class="card-body">

            <div v-if="mensaje" v-cloak class="alert alert-danger">
                {{ mensaje }}
                <ul v-if="errores.length" class="mb-0">
                    <li v-for="(error, i) in errores" v-bind:key="i">
                        {{ error }}
                    </li>
                </ul>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input type="text"
                           class="form-control"
                           v-model.trim="form.nombre">
                </div>

                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="accesoLibre"
                               v-model="form.accesoLibre">
                        <label class="form-check-label" for="accesoLibre">
                            Acceso libre (sin clases programadas, ej. Musculación)
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary me-2"
                        v-on:click="guardar"
                        v-bind:disabled="procesando">
                    {{ form.idActividad ? 'Guardar cambios' : 'Crear actividad' }}
                </button>

                <button class="btn btn-secondary"
                        v-on:click="limpiar">
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a href="#"
               class="nav-link"
               v-bind:class="{ active: pestana === 'activos' }"
               v-on:click.prevent="cambiarPestana('activos')">
                Activos
            </a>
        </li>

        <li class="nav-item">
            <a href="#"
               class="nav-link"
               v-bind:class="{ active: pestana === 'inactivos' }"
               v-on:click.prevent="cambiarPestana('inactivos')">
                Inactivos
            </a>
        </li>
    </ul>

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr v-for="actividad in actividades"
                    v-bind:key="actividad.idActividad">

                    <td>{{ actividad.nombre }}</td>

                    <td>
                        <span class="badge"
                              v-bind:class="actividad.accesoLibre ? 'bg-info text-dark' : 'bg-secondary'">
                            {{ actividad.accesoLibre ? 'Acceso libre' : 'Con clases' }}
                        </span>
                    </td>

                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary me-1"
                           v-bind:href="'/Actividad/Detalle/' + actividad.idActividad"
                           title="Ver fotos y videos">
                            <i class="bi bi-images"></i>
                        </a>

                        <template v-if="pestana === 'activos'">
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    v-on:click="editar(actividad)">
                                 <i class="bi bi-pencil"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    v-on:click="pedirBaja(actividad)">
                                  <i class="bi bi-trash"></i>
                            </button>
                        </template>

                        <template v-else>
                            <button class="btn btn-sm btn-outline-success"
                                    v-on:click="pedirReactivar(actividad)">
                                Reactivar
                            </button>
                        </template>
                    </td>
                </tr>

                <tr v-if="actividades.length === 0">
                    <td colspan="3" class="text-center text-muted py-4">
                        No hay actividades para mostrar.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            Mostrando {{ actividades.length }} de {{ total }} actividades
        </div>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select"
                    style="width:auto"
                    v-model.number="tamPagina"
                    v-on:change="cambiarTamano">
                <option :value="5">5</option>
                <option :value="10">10</option>
                <option :value="20">20</option>
            </select>

            <button class="btn btn-outline-secondary"
                    v-on:click="irAPagina(pagina - 1)"
                    v-bind:disabled="pagina <= 1">
                Anterior
            </button>

            <span class="text-nowrap">
                {{ pagina }} / {{ totalPaginas }}
            </span>

            <button class="btn btn-outline-secondary"
                    v-on:click="irAPagina(pagina + 1)"
                    v-bind:disabled="pagina >= totalPaginas">
                Siguiente
            </button>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const API = '/api/actividades';

        

        function formVacio() {
            return {
                idActividad: 0,
                nombre: '',
                accesoLibre: false
            };
        }

        Vue.createApp({
            data() {
                return {
                    actividades: [],
                    pestana: 'activos',
                    pagina: 1,
                    tamPagina: 10,
                    total: 0,
                    totalPaginas: 1,

                    form: formVacio(),
                    mensaje: '',
                    errores: [],

                    aviso: {
                        tipo: 'ok',
                        texto: ''
                    },

                    temporizadorAviso: null,
                    token: '',
                    modal: null,
                    procesando: false,

                    confirmacion: {
                        titulo: '',
                        mensaje: '',
                        textoBoton: '',
                        tipo: 'danger',
                        actividad: null,
                        accion: null
                    }
                };
            },

            async mounted() {
                this.modal = new bootstrap.Modal(
                    this.$refs.modalConfirmar
                );

                await this.iniciar();
            },

            methods: {
                async iniciar() {
                    try {
                        const resp = await fetch('/Cuenta/Token', {
                            credentials: 'same-origin'
                        });

                        if (!resp.ok) {
                            this.mostrarAviso(
                                'error',
                                'No se pudo obtener el token. Volvé a iniciar sesión.'
                            );
                            return;
                        }

                        const datos = await resp.json();
                        this.token = datos.token;

                        if (!this.token) {
                            this.mostrarAviso(
                                'error',
                                'No se recibió el token de autenticación.'
                            );
                            return;
                        }

                        await this.cargar();
                    } catch (error) {
                        this.mostrarAviso(
                            'error',
                            'No se pudo conectar con el servidor.'
                        );
                    }
                },

                async peticionApi(url, opciones = {}) {
                    const headers = new Headers(opciones.headers || {});
                    headers.set('Authorization', `Bearer ${this.token}`);

                    return fetch(url, {
                        ...opciones,
                        headers,
                        credentials: 'same-origin'
                    });
                },

                mostrarAviso(tipo, texto) {
                    this.aviso = { tipo, texto };

                    clearTimeout(this.temporizadorAviso);

                    this.temporizadorAviso = setTimeout(() => {
                        this.aviso.texto = '';
                    }, 4000);
                },

                async cargar() {
                    try {
                        const url =
                            `${API}/${this.pestana}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`;

                        const resp = await this.peticionApi(url);

                        if (!resp.ok) {
                            this.actividades = [];

                            this.mostrarAviso(
                                'error',
                                resp.status === 401
                                    ? 'Tu sesión venció. Volvé a iniciar sesión.'
                                    : resp.status === 403
                                        ? 'No tenés permisos para ver esta lista.'
                                        : 'No se pudieron cargar las actividades.'
                            );
                            return;
                        }

                        const datos = await resp.json();

                        this.actividades = datos.items ?? [];
                        this.total = datos.total ?? 0;
                        this.totalPaginas = Math.max(
                            1,
                            datos.totalPaginas ?? 1
                        );

                        if (this.pagina > this.totalPaginas) {
                            this.pagina = this.totalPaginas;
                            await this.cargar();
                        }
                    } catch (error) {
                        this.actividades = [];
                        this.mostrarAviso(
                            'error',
                            'Error al cargar las actividades.'
                        );
                    }
                },

                async cambiarPestana(nombre) {
                    if (this.pestana === nombre) return;

                    this.pestana = nombre;
                    this.pagina = 1;
                    await this.cargar();
                },

                async cambiarTamano() {
                    this.pagina = 1;
                    await this.cargar();
                },

                async irAPagina(numero) {
                    if (numero < 1 || numero > this.totalPaginas) return;

                    this.pagina = numero;
                    await this.cargar();
                },

                editar(actividad) {
                    this.form = {
                        idActividad: actividad.idActividad,
                        nombre: actividad.nombre ?? '',
                        accesoLibre: actividad.accesoLibre ?? false
                    };

                    this.mensaje = '';
                    this.errores = [];

                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                },

                limpiar() {
                    this.form = formVacio();
                    this.mensaje = '';
                    this.errores = [];
                },

                async guardar() {
                    if (this.procesando) return;

                    this.mensaje = '';
                    this.errores = [];

                    if (!this.form.nombre) {
                        this.mensaje = 'Ingresá el nombre de la actividad.';
                        return;
                    }

                    this.procesando = true;

                    try {
                        const editando = this.form.idActividad > 0;
                        const datos = new FormData();

                        datos.append('nombre', this.form.nombre);
                        datos.append('accesoLibre', this.form.accesoLibre);

                        const resp = editando
                            ? await this.peticionApi(
                                `${API}/${this.form.idActividad}`,
                                { method: 'PUT', body: datos }
                            )
                            : await this.peticionApi(
                                API,
                                { method: 'POST', body: datos }
                            );

                        const resultado = await resp.json().catch(() => null);

                        if (!resp.ok) {
                            this.mensaje =
                                resultado?.mensaje ??
                                `No se pudo guardar la actividad (HTTP ${resp.status}).`;

                            this.errores = resultado?.errores ?? [];
                            return;
                        }

                        this.mostrarAviso(
                            'ok',
                            editando
                                ? 'Actividad modificada correctamente.'
                                : 'Actividad creada correctamente.'
                        );

                        this.limpiar();
                        this.pagina = 1;
                        await this.cargar();
                    } catch (error) {
                        this.mensaje = 'Error de conexión al guardar la actividad.';
                    } finally {
                        this.procesando = false;
                    }
                },

                pedirBaja(actividad) {
                    this.confirmacion = {
                        titulo: '¿Dar de baja esta actividad?',
                        mensaje: 'La actividad dejará de aparecer entre las actividades activas. Podrás reactivarla más adelante.',
                        textoBoton: 'Sí, dar de baja',
                        tipo: 'danger',
                        actividad: actividad,
                        accion: () => this.ejecutarBaja(actividad)
                    };

                    this.modal.show();
                },

                pedirReactivar(actividad) {
                    this.confirmacion = {
                        titulo: '¿Reactivar esta actividad?',
                        mensaje: 'La actividad volverá a aparecer en la lista de actividades activas.',
                        textoBoton: 'Sí, reactivar',
                        tipo: 'success',
                        actividad: actividad,
                        accion: () => this.ejecutarReactivar(actividad)
                    };

                    this.modal.show();
                },

                async confirmar() {
                    if (this.procesando) return;

                    const accion = this.confirmacion.accion;
                    if (!accion) return;

                    this.procesando = true;

                    try {
                        this.modal.hide();
                        await accion();
                    } finally {
                        this.procesando = false;
                    }
                },

                async ejecutarBaja(actividad) {
                    try {
                        const resp = await this.peticionApi(
                            `${API}/${actividad.idActividad}`,
                            { method: 'DELETE' }
                        );

                        if (!resp.ok) {
                            const error = await resp.json().catch(() => ({}));

                            this.mostrarAviso(
                                'error',
                                error.mensaje ??
                                `No se pudo dar de baja (HTTP ${resp.status}).`
                            );
                            return;
                        }

                        this.mostrarAviso(
                            'ok',
                            `La actividad "${actividad.nombre}" fue dada de baja.`
                        );

                        await this.cargar();
                    } catch (error) {
                        this.mostrarAviso(
                            'error',
                            'Error de conexión al dar de baja la actividad.'
                        );
                    }
                },

                async ejecutarReactivar(actividad) {
                    try {
                        const resp = await this.peticionApi(
                            `${API}/${actividad.idActividad}/reactivar`,
                            { method: 'PUT' }
                        );

                        if (!resp.ok) {
                            const error = await resp.json().catch(() => ({}));

                            this.mostrarAviso(
                                'error',
                                error.mensaje ??
                                `No se pudo reactivar (HTTP ${resp.status}).`
                            );
                            return;
                        }

                        this.mostrarAviso(
                            'ok',
                            `La actividad "${actividad.nombre}" fue reactivada.`
                        );

                        await this.cargar();
                    } catch (error) {
                        this.mostrarAviso(
                            'error',
                            'Error de conexión al reactivar la actividad.'
                        );
                    }
                }
            }
        }).mount('#app');
    </script>
}
