@model Gimnasio_Alcaraz_Ballerini_Delicia.Models.Actividad
@{
    ViewData["Title"] = "Detalle de actividad";
    var puedeEditar = User.IsInRole("Administrador") || User.IsInRole("Empleado");
}

<div id="app" class="mt-4">

    <!-- AVISOS -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div v-if="aviso.texto"
             class="toast show text-white border-0"
             v-bind:class="aviso.tipo === 'ok' ? 'bg-success' : 'bg-danger'">
            <div class="d-flex">
                <div class="toast-body">{{ aviso.texto }}</div>
                <button class="btn-close btn-close-white me-2 m-auto"
                        v-on:click="aviso.texto = ''"></button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@Model.Nombre</h2>

        
     
            <a asp-controller="Actividad" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver a actividades
            </a>
        
    </div>

    <!-- CARRUSEL -->
    <div v-if="archivos.length"
         v-bind:key="versionCarrusel"
         id="carrusel"
         class="carousel slide mb-4 mx-auto"
         data-bs-interval="false"
         style="max-width:900px">

        <div class="carousel-indicators">
            <button v-for="(a, i) in archivos"
                    v-bind:key="a.idArchivo"
                    type="button"
                    data-bs-target="#carrusel"
                    v-bind:data-bs-slide-to="i"
                    v-bind:class="{ active: i === 0 }"
                    v-bind:aria-label="'Archivo ' + (i + 1)"></button>
        </div>

        <div class="carousel-inner rounded bg-dark">
            <div v-for="(a, i) in archivos"
                 v-bind:key="a.idArchivo"
                 class="carousel-item"
                 v-bind:class="{ active: i === 0 }">

                <video v-if="a.esVideo"
                       v-bind:src="a.ruta"
                       controls muted preload="metadata"
                       class="d-block w-100"
                       style="height:480px;object-fit:contain"></video>

                <img v-else
                     v-bind:src="a.ruta"
                     class="d-block w-100"
                     style="height:480px;object-fit:contain"
                     v-bind:alt="'Archivo ' + (i + 1) + ' de la actividad'">
            </div>
        </div>

        <button class="carousel-control-prev" type="button"
                data-bs-target="#carrusel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#carrusel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>

    <div v-else-if="!cargando"
         class="alert alert-light border text-center mx-auto"
         style="max-width:900px">
        <i class="bi bi-images fs-2 d-block mb-2"></i>
        Esta actividad todavía no tiene fotos ni videos.
    </div>

    <!-- ADMINISTRAR (solo Administrador y Empleado) -->
    <div class="card mb-4" v-if="puedeEditar">
        <div class="card-header">Administrar fotos y videos</div>

        <div class="card-body">

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Agregar fotos o videos</label>
                    <input type="file"
                           class="form-control"
                           multiple
                           ref="inputArchivos"
                           accept=".jpg,.jpeg,.png,.webp,.gif,.mp4,.webm"
                           v-on:change="seleccionar">
                    <small class="text-muted">
                        Imágenes JPG, PNG, WEBP o GIF (hasta 5 MB) · Videos MP4 o WEBM (hasta 20 MB) ·
                        Máximo 10 archivos por actividad.
                    </small>
                </div>

                <div class="col-md-4">
                    <button class="btn btn-primary"
                            v-on:click="subir"
                            v-bind:disabled="subiendo || seleccionados.length === 0">
                        {{ subiendo
                            ? 'Subiendo...'
                            : (seleccionados.length
                                ? 'Subir ' + seleccionados.length + ' archivo(s)'
                                : 'Subir') }}
                    </button>
                </div>
            </div>

            <!-- Archivos que ya tiene la actividad -->
            <div class="row g-3 mt-2" v-if="archivos.length">
                <div class="col-6 col-md-3" v-for="a in archivos" v-bind:key="a.idArchivo">
                    <div class="border rounded p-2 h-100 text-center">
                        <video v-if="a.esVideo"
                               v-bind:src="a.ruta"
                               muted preload="metadata"
                               class="w-100 rounded"
                               style="height:100px;object-fit:cover"></video>
                        <img v-else
                             v-bind:src="a.ruta"
                             alt="Archivo de la actividad"
                             class="w-100 rounded"
                             style="height:100px;object-fit:cover">

                        <button class="btn btn-sm btn-outline-danger mt-2"
                                v-on:click="eliminar(a)"
                                v-bind:disabled="subiendo">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const ID_ACTIVIDAD = @Model.IdActividad;
        const API = '/api/actividades';

        // Mismas reglas que el servidor (ActividadArchivoService)
        function validarArchivo(archivo) {
            const esVideo = /\.(mp4|webm)$/i.test(archivo.name);
            const esImagen = /\.(jpe?g|png|webp|gif)$/i.test(archivo.name);

            if (!esVideo && !esImagen)
                return `"${archivo.name}": formato no permitido.`;

            if (esVideo && archivo.size > 20 * 1024 * 1024)
                return `"${archivo.name}": el video supera los 20 MB.`;

            if (esImagen && archivo.size > 5 * 1024 * 1024)
                return `"${archivo.name}": la imagen supera los 5 MB.`;

            return '';
        }

        Vue.createApp({
            data() {
                return {
                    archivos: [],
                    cargando: true,
                    versionCarrusel: 0,
                    puedeEditar: @(puedeEditar ? "true" : "false"),

                    seleccionados: [],
                    subiendo: false,

                    aviso: { tipo: 'ok', texto: '' },
                    temporizadorAviso: null,
                    token: ''
                };
            },

            async mounted() {
                // Al pasar de slide se pausan los videos que estaban reproduciéndose
                document.addEventListener('slide.bs.carousel', () => {
                    document.querySelectorAll('#carrusel video')
                        .forEach(v => v.pause());
                });

                await this.iniciar();
            },

            methods: {
                async iniciar() {
                    try {
                        const resp = await fetch('/Cuenta/Token', {
                            credentials: 'same-origin'
                        });

                        if (!resp.ok) {
                            this.mostrarAviso('error',
                                'No se pudo obtener el token. Volvé a iniciar sesión.');
                            this.cargando = false;
                            return;
                        }

                        const datos = await resp.json();
                        this.token = datos.token;

                        await this.cargar();
                    } catch (error) {
                        this.cargando = false;
                        this.mostrarAviso('error', 'No se pudo conectar con el servidor.');
                    }
                },

                async peticionApi(url, opciones = {}) {
                    const headers = new Headers(opciones.headers || {});
                    headers.set('Authorization', `Bearer ${this.token}`);

                    return fetch(url, {
                        ...opciones,
                        headers,
                        credentials: 'same-origin'
                    });
                },

                mostrarAviso(tipo, texto) {
                    this.aviso = { tipo, texto };

                    clearTimeout(this.temporizadorAviso);

                    this.temporizadorAviso = setTimeout(() => {
                        this.aviso.texto = '';
                    }, 5000);
                },

                async cargar() {
                    try {
                        const resp = await this.peticionApi(
                            `${API}/${ID_ACTIVIDAD}/archivos`
                        );

                        if (!resp.ok) {
                            this.archivos = [];
                            this.mostrarAviso('error', 'No se pudieron cargar los archivos.');
                            return;
                        }

                        this.archivos = await resp.json();

                        // Se recrea el carrusel para que arranque siempre en la primera imagen
                        this.versionCarrusel++;
                    } catch (error) {
                        this.archivos = [];
                        this.mostrarAviso('error', 'Error al cargar los archivos.');
                    } finally {
                        this.cargando = false;
                    }
                },

                seleccionar(evento) {
                    const elegidos = Array.from(evento.target.files);
                    const validos = [];
                    const errores = [];

                    for (const archivo of elegidos) {
                        const error = validarArchivo(archivo);

                        if (error) errores.push(error);
                        else validos.push(archivo);
                    }

                    this.seleccionados = validos;

                    if (errores.length) {
                        this.mostrarAviso('error', errores.join(' '));
                    }
                },

                async subir() {
                    if (this.subiendo || this.seleccionados.length === 0) return;

                    this.subiendo = true;

                    let subidos = 0;
                    const errores = [];

                    try {
                        // Uno por uno: si alguno falla, se informa cuál y los demás siguen
                        for (const archivo of this.seleccionados) {
                            const datos = new FormData();
                            datos.append('archivo', archivo);

                            const resp = await this.peticionApi(
                                `${API}/${ID_ACTIVIDAD}/archivos`,
                                { method: 'POST', body: datos }
                            );

                            if (resp.ok) {
                                subidos++;
                            } else {
                                const error = await resp.json().catch(() => ({}));
                                errores.push(
                                    `"${archivo.name}": ` +
                                    (error.mensaje ?? `error HTTP ${resp.status}`)
                                );
                            }
                        }
                    } catch (error) {
                        errores.push('Error de conexión al subir los archivos.');
                    } finally {
                        this.seleccionados = [];

                        if (this.$refs.inputArchivos)
                            this.$refs.inputArchivos.value = '';

                        this.subiendo = false;
                    }

                    if (errores.length) {
                        this.mostrarAviso('error',
                            (subidos ? `Se subieron ${subidos}. ` : '') + errores.join(' '));
                    } else {
                        this.mostrarAviso('ok',
                            subidos === 1
                                ? 'Archivo subido correctamente.'
                                : `${subidos} archivos subidos correctamente.`);
                    }

                    await this.cargar();
                },

                async eliminar(archivo) {
                    if (this.subiendo) return;

                    if (!confirm('¿Eliminar este archivo de la actividad?')) return;

                    try {
                        const resp = await this.peticionApi(
                            `${API}/archivos/${archivo.idArchivo}`,
                            { method: 'DELETE' }
                        );

                        if (!resp.ok) {
                            const error = await resp.json().catch(() => ({}));
                            this.mostrarAviso('error',
                                error.mensaje ?? 'No se pudo eliminar el archivo.');
                            return;
                        }

                        this.mostrarAviso('ok', 'Archivo eliminado correctamente.');
                        await this.cargar();
                    } catch (error) {
                        this.mostrarAviso('error', 'Error de conexión al eliminar el archivo.');
                    }
                }
            }
        }).mount('#app');
    </script>
}
