
@{
    ViewData["Title"] = "Usuarios";
}

<div id="app" class="container mt-4 mb-5">

    <h2 class="mb-4">Usuarios</h2>

    <!-- MENSAJES -->
    <div v-if="mensaje"
         class="alert"
         :class="mensajeTipo === 'ok'
            ? 'alert-success'
            : 'alert-danger'">
        {{ mensaje }}
    </div>

    <!-- FORMULARIO -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark text-white">
            {{ form.idUsuario > 0
                ? 'Modificar usuario'
                : 'Nuevo usuario' }}
        </div>

        <div class="card-body">

            <form @@submit.prevent="guardar" autocomplete="off">

                <div class="mb-3">
                    <label class="form-label">
                        Email
                    </label>

                    <input type="email"
                           class="form-control"
                           v-model="form.email"
                          autocomplete="new-password"
                          required>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Password
                    </label>

                    <input type="password"
                           class="form-control"
                           v-model="form.password"
                           required
                           minlength="6"
                           maxlength="20">

                    <small class="text-muted">
                        Ingresá la contraseña para crear o modificar el usuario.
                    </small>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Rol
                    </label>

                    <select class="form-select"
                            v-model.number="form.roles">

                        <option :value="1">Socio</option>
                        <option :value="2">Empleado</option>
                        <option :value="3">Administrador</option>

                    </select>
                </div>

                <!-- AVATAR ACTUAL -->
                <div class="mb-3" v-if="form.idUsuario > 0">

                    <label class="form-label d-block">
                        Avatar actual
                    </label>

                    <img v-if="avatarActual"
                         :src="avatarActual"
                         alt="Avatar del usuario"
                         class="rounded-circle border"
                         style="width: 90px; height: 90px; object-fit: cover;">

                    <div v-else
                         class="rounded-circle border bg-light d-flex align-items-center justify-content-center"
                         style="width: 90px; height: 90px;">

                        <i class="bi bi-person text-secondary"
                           style="font-size: 2.5rem;"></i>

                    </div>

                </div>

                <!-- SELECCIONAR AVATAR -->
                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-image"></i>
                        {{ form.idUsuario > 0
                            ? 'Cambiar avatar'
                            : 'Avatar (opcional)' }}
                    </label>

                    <input type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           @@change="seleccionarAvatar">

                    <small class="text-muted">
                        Formatos permitidos: JPG, PNG y WEBP.
                        Tamaño máximo: 5 MB.
                    </small>

                </div>

                <!-- VISTA PREVIA -->
                <div class="mb-3" v-if="avatarPreview">

                    <label class="form-label">
                        Vista previa
                    </label>

                    <div>
                        <img :src="avatarPreview"
                             alt="Vista previa del avatar"
                             class="rounded-circle border"
                             style="width: 100px; height: 100px; object-fit: cover;">
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary"
                        :disabled="guardando">

                    {{ guardando
                        ? 'Guardando...'
                        : (form.idUsuario > 0
                            ? 'Guardar cambios'
                            : 'Crear usuario') }}

                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        @@click="limpiar"
                        :disabled="guardando">

                    Cancelar

                </button>

            </form>

        </div>
    </div>

    <!-- PESTAÑAS Y PAGINACIÓN -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">

        <div>
            <button class="btn"
                    :class="pestana === 'activos'
                        ? 'btn-primary'
                        : 'btn-outline-primary'"
                    @@click="cambiarPestana('activos')">

                Activos
            </button>

            <button class="btn ms-2"
                    :class="pestana === 'inactivos'
                        ? 'btn-primary'
                        : 'btn-outline-primary'"
                    @@click="cambiarPestana('inactivos')">

                Inactivos
            </button>
        </div>

        <select class="form-select"
                style="width: 100px"
                v-model.number="tamPagina"
                @@change="cambiarTamano">

            <option :value="5">5</option>
            <option :value="10">10</option>
            <option :value="20">20</option>

        </select>

    </div>

    <!-- TABLA -->
    <div class="table-responsive">

        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Avatar</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                <tr v-for="usuario in usuarios"
                    :key="usuario.idUsuario">

                    <td>
                        {{ usuario.idUsuario }}
                    </td>

                    <!-- FOTO DEL USUARIO -->
                    <td>

                        <img v-if="usuario.avatar"
                             :src="usuario.avatar"
                             alt="Avatar"
                             class="rounded-circle border"
                             style="width: 55px; height: 55px; object-fit: cover;">

                        <div v-else
                             class="rounded-circle border bg-light d-flex align-items-center justify-content-center"
                             style="width: 55px; height: 55px;">

                            <i class="bi bi-person text-secondary"
                               style="font-size: 1.7rem;"></i>

                        </div>

                    </td>

                    <td>
                        {{ usuario.email }}
                    </td>

                    <td>

                        <span v-if="usuario.roles === 1"
                              class="badge bg-primary">
                            Socio
                        </span>

                        <span v-else-if="usuario.roles === 2"
                              class="badge bg-info text-dark">
                            Empleado
                        </span>

                        <span v-else-if="usuario.roles === 3"
                              class="badge bg-dark">
                            Administrador
                        </span>

                    </td>

                    <td>

                        <button v-if="pestana === 'activos'"
                                class="btn btn-sm btn-warning"
                                @@click="editar(usuario)">

                            Editar
                        </button>

                        <button v-if="pestana === 'activos'"
                                class="btn btn-sm btn-danger ms-1"
                                @@click="darDeBaja(usuario)">

                            Baja
                        </button>

                        <button v-if="pestana === 'inactivos'"
                                class="btn btn-sm btn-success"
                                @@click="reactivar(usuario)">

                            Reactivar
                        </button>

                    </td>

                </tr>

                <tr v-if="usuarios.length === 0">
                    <td colspan="5"
                        class="text-center text-muted py-4">

                        No hay usuarios para mostrar.

                    </td>
                </tr>

            </tbody>

        </table>

    </div>

    <!-- NAVEGACIÓN DE PÁGINAS -->
    <div class="d-flex justify-content-center align-items-center mt-4">

        <button class="btn btn-secondary"
                :disabled="pagina <= 1"
                @@click="irAPagina(pagina - 1)">

            Anterior
        </button>

        <span class="mx-3">
            Página {{ pagina }} de {{ totalPaginas }}
        </span>

        <button class="btn btn-secondary"
                :disabled="pagina >= totalPaginas"
                @@click="irAPagina(pagina + 1)">

            Siguiente
        </button>

    </div>

</div>


@section Scripts {

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>

        const API = '/api/usuarios';

        function formVacio() {
            return {
                idUsuario: 0,
                email: '',
                password: '',
                roles: 1
            };
        }

        Vue.createApp({

            data() {
                return {
                    usuarios: [],
                    pagina: 1,
                    tamPagina: 10,
                    total: 0,
                    totalPaginas: 1,
                    pestana: 'activos',
                    form: formVacio(),
                    avatarActual: '',
                    avatarFile: null,
                    avatarPreview: '',
                    guardando: false,
                    mensaje: '',
                    mensajeTipo: 'ok',
                    token: ''
                };
            },

            async mounted() {
                await this.iniciar();
            },

            methods: {

                // OBTENER EL JWT DE LA SESIÓN ACTUAL
               
                async iniciar() {
                    try {
                        const respuesta = await fetch('/Cuenta/Token', {
                            method: 'GET',
                            credentials: 'same-origin'
                        });

                        if (!respuesta.ok) {
                            this.mostrarAviso(
                                'error',
                                'No se pudo obtener el token. Verificá que hayas iniciado sesión nuevamente.'
                            );
                            return;
                        }

                        const datos = await respuesta.json();

                        if (!datos.token) {
                            this.mostrarAviso(
                                'error',
                                'El servidor no devolvió un token JWT.'
                            );
                            return;
                        }

                        this.token = datos.token;

                        await this.cargar();

                    } catch (error) {
                        console.error('Error al obtener el token:', error);

                        this.mostrarAviso(
                            'error',
                            'No se pudo conectar con el servidor para obtener el token.'
                        );
                    }
                },

          
                // FUNCIÓN CENTRAL PARA LLAMAR A LA API
                // TODAS LAS PETICIONES ENVIAN EL JWT
                
                async peticionApi(url, opciones = {}) {

                    if (!this.token) {
                        throw new Error(
                            'No hay un token JWT disponible.'
                        );
                    }

                    const headers = new Headers(
                        opciones.headers || {}
                    );

                    headers.set(
                        'Authorization',
                        `Bearer ${this.token}`
                    );

                    return fetch(url, {
                        ...opciones,
                        headers: headers,
                        credentials: 'same-origin'
                    });
                },

                // ==========================================
                // LISTAR USUARIOS CON PAGINACIÓN
                // ==========================================
                async cargar() {
                    try {
                        const resp = await this.peticionApi(
                            `${API}/${this.pestana}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`
                        );

                        if (!resp.ok) {
                            if (resp.status === 401) {
                                this.mostrarAviso(
                                    'error',
                                    'La sesión o el token no son válidos. Volvé a iniciar sesión.'
                                );
                                return;
                            }

                            if (resp.status === 403) {
                                this.mostrarAviso(
                                    'error',
                                    'No tenés permisos de administrador para gestionar usuarios.'
                                );
                                return;
                            }

                            this.mostrarAviso(
                                'error',
                                'No se pudieron cargar los usuarios. Código HTTP: ' + resp.status
                            );
                            return;
                        }

                        const datos = await resp.json();

                        this.usuarios = datos.items || [];
                        this.total = datos.total || 0;

                        this.totalPaginas = Math.max(
                            1,
                            Math.ceil(this.total / this.tamPagina)
                        );

                        if (this.pagina > this.totalPaginas) {
                            this.pagina = this.totalPaginas;
                            await this.cargar();
                        }

                    } catch (error) {
                        console.error('Error al cargar usuarios:', error);

                        this.mostrarAviso(
                            'error',
                            'No se pudo conectar con el servidor al cargar los usuarios.'
                        );
                    }
                },

                // ==========================================
                // SELECCIONAR Y VALIDAR AVATAR
                // ==========================================
                seleccionarAvatar(evento) {
                    const archivo = evento.target.files[0];

                    this.avatarFile = null;
                    this.avatarPreview = '';

                    if (!archivo)
                        return;

                    const tiposPermitidos = [
                        'image/jpeg',
                        'image/png',
                        'image/webp'
                    ];

                    if (!tiposPermitidos.includes(archivo.type)) {
                        this.mostrarAviso(
                            'error',
                            'Seleccioná una imagen JPG, PNG o WEBP.'
                        );

                        evento.target.value = '';
                        return;
                    }

                    if (archivo.size > 5 * 1024 * 1024) {
                        this.mostrarAviso(
                            'error',
                            'La imagen no puede superar los 5 MB.'
                        );

                        evento.target.value = '';
                        return;
                    }

                    this.avatarFile = archivo;
                    this.avatarPreview = URL.createObjectURL(archivo);
                },

                // ==========================================
                // CREAR O MODIFICAR USUARIO
                // ==========================================
                async guardar() {
                    if (this.guardando)
                        return;

                    this.guardando = true;
                    this.mensaje = '';

                    try {
                        const editando = this.form.idUsuario > 0;

                        const datos = {
                            email: this.form.email,
                            password: this.form.password,
                            roles: this.form.roles
                        };

                        const resp = await this.peticionApi(
                            editando
                                ? `${API}/${this.form.idUsuario}`
                                : API,
                            {
                                method: editando ? 'PUT' : 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(datos)
                            }
                        );

                        if (!resp.ok) {
                            let error = {};

                            try {
                                error = await resp.json();
                            } catch {
                                // La respuesta podría no ser JSON.
                            }

                            this.mostrarAviso(
                                'error',
                                error.mensaje ||
                                'No se pudo guardar el usuario. Código HTTP: ' + resp.status
                            );

                            return;
                        }

                        const usuarioGuardado = await resp.json();

                        const idUsuario = editando
                            ? this.form.idUsuario
                            : usuarioGuardado.idUsuario;

                        // Subir el avatar si se seleccionó uno.
                        if (this.avatarFile) {
                            const formData = new FormData();

                            formData.append(
                                'avatarFile',
                                this.avatarFile
                            );

                            const respAvatar = await this.peticionApi(
                                `${API}/${idUsuario}/avatar`,
                                {
                                    method: 'PUT',
                                    body: formData
                                }
                            );

                            if (!respAvatar.ok) {
                                let errorAvatar = {};

                                try {
                                    errorAvatar = await respAvatar.json();
                                } catch {
                                    // Puede no haber contenido JSON.
                                }

                                this.mostrarAviso(
                                    'error',
                                    errorAvatar.mensaje ||
                                    'El usuario se guardó, pero no se pudo actualizar el avatar.'
                                );

                                await this.cargar();
                                return;
                            }
                        }

                        const habiaAvatar = this.avatarFile !== null;

                        this.limpiar();

                        this.mostrarAviso(
                            'ok',
                            habiaAvatar
                                ? 'Usuario y avatar guardados correctamente.'
                                : (editando
                                    ? 'Usuario actualizado correctamente.'
                                    : 'Usuario creado correctamente.')
                        );

                        await this.cargar();

                    } catch (error) {
                        console.error('Error al guardar:', error);

                        this.mostrarAviso(
                            'error',
                            'Ocurrió un error al conectar con el servidor.'
                        );
                    } finally {
                        this.guardando = false;
                    }
                },

                // ==========================================
                // CARGAR USUARIO EN EL FORMULARIO
                // ==========================================
                editar(usuario) {
                    this.form = {
                        idUsuario: usuario.idUsuario,
                        email: usuario.email,
                        password: usuario.password || '',
                        roles: usuario.roles
                    };

                    this.avatarActual = usuario.avatar || '';
                    this.avatarFile = null;
                    this.avatarPreview = '';

                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                },

                // ==========================================
                // LIMPIAR FORMULARIO
                // ==========================================
                limpiar() {
                    this.form = formVacio();
                    this.avatarActual = '';
                    this.avatarFile = null;
                    this.avatarPreview = '';
                    this.mensaje = '';

                    const inputArchivo =
                        document.querySelector('input[type="file"]');

                    if (inputArchivo)
                        inputArchivo.value = '';
                },

                // ==========================================
                // DAR DE BAJA A UN USUARIO
                // ==========================================
                async darDeBaja(usuario) {
                    const confirmar = confirm(
                        `¿Dar de baja al usuario ${usuario.email}?`
                    );

                    if (!confirmar)
                        return;

                    try {
                        const resp = await this.peticionApi(
                            `${API}/${usuario.idUsuario}`,
                            {
                                method: 'DELETE'
                            }
                        );

                        if (!resp.ok) {
                            let error = {};

                            try {
                                error = await resp.json();
                            } catch {
                                // Puede no haber contenido JSON.
                            }

                            this.mostrarAviso(
                                'error',
                                error.mensaje ||
                                'No se pudo dar de baja. Código HTTP: ' + resp.status
                            );

                            return;
                        }

                        this.mostrarAviso(
                            'ok',
                            'Usuario dado de baja correctamente.'
                        );

                        await this.cargar();

                    } catch (error) {
                        console.error('Error al dar de baja:', error);

                        this.mostrarAviso(
                            'error',
                            'No se pudo conectar con el servidor.'
                        );
                    }
                },

                // ==========================================
                // REACTIVAR USUARIO
                // ==========================================
                async reactivar(usuario) {
                    try {
                        const resp = await this.peticionApi(
                            `${API}/${usuario.idUsuario}/reactivar`,
                            {
                                method: 'PUT'
                            }
                        );

                        if (!resp.ok) {
                            let error = {};

                            try {
                                error = await resp.json();
                            } catch {
                                // Puede no haber contenido JSON.
                            }

                            this.mostrarAviso(
                                'error',
                                error.mensaje ||
                                'No se pudo reactivar. Código HTTP: ' + resp.status
                            );

                            return;
                        }

                        this.mostrarAviso(
                            'ok',
                            'Usuario reactivado correctamente.'
                        );

                        await this.cargar();

                    } catch (error) {
                        console.error('Error al reactivar:', error);

                        this.mostrarAviso(
                            'error',
                            'No se pudo conectar con el servidor.'
                        );
                    }
                },

                // ==========================================
                // CAMBIAR ENTRE ACTIVOS E INACTIVOS
                // ==========================================
                async cambiarPestana(nombre) {
                    this.pestana = nombre;
                    this.pagina = 1;

                    await this.cargar();
                },

                // ==========================================
                // CAMBIAR TAMAÑO DE PÁGINA
                // ==========================================
                async cambiarTamano() {
                    this.pagina = 1;

                    await this.cargar();
                },

                // ==========================================
                // NAVEGAR ENTRE PÁGINAS
                // ==========================================
                async irAPagina(numero) {
                    if (numero < 1 || numero > this.totalPaginas)
                        return;

                    this.pagina = numero;

                    await this.cargar();
                },

                // ==========================================
                // MOSTRAR MENSAJES EN LA VISTA
                // ==========================================
                mostrarAviso(tipo, mensaje) {
                    this.mensajeTipo = tipo === 'ok'
                        ? 'ok'
                        : 'error';

                    this.mensaje = mensaje;
                }

            }

        }).mount('#app');

    </script>
}
