@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4" id="app">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Usuarios</h1>
            <p class="text-muted mb-0">
                Administración de usuarios, roles y perfiles del sistema.
            </p>
        </div>

 
    </div>

    <div v-if="mensaje" v-cloak class="alert alert-dismissible fade show"
         :class="mensajeTipo === 'ok' ? 'alert-success' : 'alert-danger'" role="alert">
        {{ mensaje }}
        <button type="button" class="btn-close" @@click="mensaje = ''" aria-label="Cerrar"></button>
    </div>

    <!-- Modal: convertir en socio (solo si nunca tuvo ficha) -->
    <div class="modal fade" tabindex="-1" ref="modalSocio" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form @@submit.prevent="confirmarConversion" autocomplete="off" novalidate>

                    <div class="modal-header">
                        <h5 class="modal-title">Convertir en socio</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <p class="text-muted small mb-3" v-if="usuarioAConvertir">
                            Se conserva la cuenta <strong>{{ usuarioAConvertir.email }}</strong>.
                            Completá los datos personales del socio.
                        </p>

                        <div v-if="errorModal" v-cloak class="alert alert-danger">
                            <div>{{ errorModal }}</div>
                            <ul class="mb-0" v-if="erroresModal.length">
                                <li v-for="e in erroresModal" :key="e">{{ e }}</li>
                            </ul>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Nombre</label>
                                <input class="form-control" v-model="socioForm.nombre">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellido</label>
                                <input class="form-control" v-model="socioForm.apellido">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">DNI</label>
                                <input class="form-control" v-model="socioForm.dni">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Teléfono</label>
                                <input class="form-control" v-model="socioForm.telefono">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Domicilio</label>
                                <input class="form-control" v-model="socioForm.domicilio">
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" :disabled="convirtiendo">
                            {{ convirtiendo ? 'Guardando...' : 'Convertir en socio' }}
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- FORMULARIO: se mantienen las clases  -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">
                {{ form.idUsuario > 0 ? 'Modificar usuario' : 'Nuevo usuario' }}
            </h5>

            <form @@submit.prevent="guardar" autocomplete="off">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" v-model="form.email" autocomplete="new-password"
                               placeholder="Ingrese el email" required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" v-model="form.password"
                               :required="form.idUsuario === 0" minlength="6" maxlength="20" autocomplete="new-password"
                               placeholder="Ingrese la contraseña">
                        <small class="text-muted">
                            Al crear es obligatoria. Al editar, dejala vacía para no cambiarla.
                        </small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Rol</label>
                        <select class="form-select" v-model.number="form.roles">
                   
                            <option :value="2">Empleado</option>
                            <option :value="3">Administrador</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            <i class="bi bi-image me-1"></i>
                            {{ form.idUsuario > 0 ? 'Cambiar avatar' : 'Avatar (opcional)' }}
                        </label>
                        <input type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp"
                        @@change="seleccionarAvatar">
                        <small class="text-muted">Formatos permitidos: JPG, PNG y WEBP. Tamaño máximo: 5 MB.</small>
                    </div>
                </div>

                <div class="mb-3" v-if="form.idUsuario > 0">
                    <label class="form-label d-block">Avatar actual</label>
                    <img v-if="avatarActual" :src="avatarActual" alt="Avatar del usuario" class="rounded-circle border"
                         style="width: 90px; height: 90px; object-fit: cover;">
                    <div v-else class="rounded-circle border bg-light d-flex align-items-center justify-content-center"
                         style="width: 90px; height: 90px;">
                        <i class="bi bi-person text-secondary" style="font-size: 2.5rem;"></i>
                    </div>
                </div>

                <div class="mb-3" v-if="avatarPreview">
                    <label class="form-label d-block">Vista previa</label>
                    <img :src="avatarPreview" alt="Vista previa del avatar" class="rounded-circle border"
                         style="width: 100px; height: 100px; object-fit: cover;">
                </div>

                <button type="submit" class="btn btn-primary" :disabled="guardando">
                    <i class="bi bi-check-circle me-1"></i>
                    {{ guardando ? 'Guardando...' : (form.idUsuario > 0 ? 'Guardar cambios' : 'Crear usuario') }}
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" @@click="limpiar" :disabled="guardando">
                    Cancelar
                </button>
            </form>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link" :class="{ active: pestana === 'activos' }" @@click="cambiarPestana('activos')">
                Activos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" :class="{ active: pestana === 'inactivos' }" @@click="cambiarPestana('inactivos')">
                Inactivos
            </button>
        </li>
    </ul>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-end align-items-center mb-3">
                <label for="tamPagina" class="form-label me-2 mb-0">Mostrar:</label>
                <select id="tamPagina" class="form-select" style="width: 100px" v-model.number="tamPagina"
                    @@change="cambiarTamano">
                    <option :value="5">5</option>
                    <option :value="10">10</option>
                    <option :value="20">20</option>
                </select>
            </div>

            <div v-if="usuarios.length === 0" class="text-center text-muted py-5">
                <i class="bi bi-people fs-1"></i>
                <p class="mt-3 mb-0">No hay usuarios para mostrar.</p>
            </div>

            <div v-else class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Avatar</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th>Socio</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="usuario in usuarios" :key="usuario.idUsuario">
                            <td>{{ usuario.idUsuario }}</td>
                            <td>
                                <img v-if="usuario.avatar" :src="usuario.avatar" alt="Avatar"
                                     class="rounded-circle border" style="width: 55px; height: 55px; object-fit: cover;">
                                <div v-else
                                     class="rounded-circle border bg-light d-flex align-items-center justify-content-center"
                                     style="width: 55px; height: 55px;">
                                    <i class="bi bi-person text-secondary" style="font-size: 1.7rem;"></i>
                                </div>
                            </td>
                            <td>{{ usuario.email }}</td>
                            <td>
                                <span v-if="usuario.roles === 1" class="badge bg-primary">Socio</span>
                                <span v-else-if="usuario.roles === 2" class="badge bg-info text-dark">Empleado</span>
                                <span v-else-if="usuario.roles === 3" class="badge bg-dark">Administrador</span>
                            </td>
                            <td>
                                <span v-if="usuario.socio">{{ usuario.socio.apellido }}, {{ usuario.socio.nombre
                                    }}</span>
                                    <span v-else-if="usuario.roles === 1" class="badge bg-warning text-dark">Sin socio
                                        asignado</span>
                                        <span v-else class="text-muted">—</span>
                                    </td>
                                    <td class="text-end">
                                        <!-- Botón para editar (carga el usuario en el formulario) -->
                                        <button v-if="pestana === 'activos'" type="button"
                                                class="btn btn-sm btn-outline-primary me-1" title="Editar"
                                            @@click="editar(usuario)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <!-- Botón para convertir en socio -->
                                        <button v-if="pestana === 'activos' && usuario.estado && usuario.roles !== 1"
                                                type="button" class="btn btn-sm btn-outline-success me-1" title="Convertir en socio"
                                            @@click="convertirEnSocio(usuario)">
                                            <i class="bi bi-person-plus"></i>
                                        </button>
                                        <button v-if="pestana === 'activos'" type="button"
                                                class="btn btn-sm btn-outline-danger me-1" title="Dar de baja"
                                            @@click="darDeBaja(usuario)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        <button v-else type="button" class="btn btn-sm btn-outline-success" title="Reactivar"
                                            @@click="reactivar(usuario)">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div v-if="totalPaginas > 1" class="d-flex justify-content-center mt-3">
                        <nav aria-label="Paginación de usuarios">
                            <ul class="pagination mb-0">
                                <li class="page-item" :class="{ disabled: pagina === 1 }">
                                    <button type="button" class="page-link" @@click="irAPagina(pagina - 1)">
                                        Anterior
                                    </button>
                                </li>
                                <li v-for="n in totalPaginas" :key="n" class="page-item" :class="{ active: pagina === n }">
                                    <button type="button" class="page-link" @@click="irAPagina(n)">{{ n }}</button>
                                </li>
                                <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
                                    <button type="button" class="page-link" @@click="irAPagina(pagina + 1)">
                                        Siguiente
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {

            <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

            <script>

                const API = '/api/usuarios';

                function formVacio() {
                    return {
                        idUsuario: 0,
                        email: '',
                        password: '',
                        roles: 2
                    };
                }

                function socioVacio() {
                    return { nombre: '', apellido: '', dni: '', telefono: '', domicilio: '' };
                }

                Vue.createApp({

                    data() {
                        return {
                            usuarios: [],
                            pagina: 1,
                            tamPagina: 10,
                            total: 0,
                            totalPaginas: 1,
                            pestana: 'activos',
                            form: formVacio(),
                            avatarActual: '',
                            avatarFile: null,
                            avatarPreview: '',
                            guardando: false,
                            mensaje: '',
                            mensajeTipo: 'ok',
                            token: '',
                            modalSocio: null,
                            usuarioAConvertir: null,
                            socioForm: socioVacio(),
                            errorModal: '',
                            erroresModal: [],
                            convirtiendo: false,
                        };
                    },

                    async mounted() {
                        this.modalSocio = new bootstrap.Modal(this.$refs.modalSocio);
                        await this.iniciar();
                    },

                    methods: {

                        // OBTENER EL JWT DE LA SESIÓN ACTUAL
               
                        async iniciar() {
                            try {
                                const respuesta = await fetch('/Cuenta/Token', { method: 'GET',
                                    credentials: 'same-origin'
                                });

                                if (!respuesta.ok) {
                                    this.mostrarAviso(
                                        'error',
                                        'No se pudo obtener el token. Verificá que hayas iniciado sesión nuevamente.'
                                    );
                                    return;
                                }

                                const datos = await respuesta.json();

                                if (!datos.token) { this.mostrarAviso( 'error',
                                        'El servidor no devolvió un token JWT.'
                                    );
                                    return;
                                }

                                this.token = datos.token;

                                await this.cargar();

                            } catch (error) {
                                console.error('Error al obtener el token:', error);

                                this.mostrarAviso(
                                    'error',
                                    'No se pudo conectar con el servidor para obtener el token.'
                                );
                            }
                        },

          
    
                        // TODAS LAS PETICIONES ENVIAN EL JWT
                
                        async peticionApi(url, opciones = {}) {

                            if (!this.token) {
                                throw new Error('No hay un token JWT disponible.' );
                            }

                            const headers = new Headers(
                                opciones.headers || {}
                            );

                            headers.set(
                                'Authorization',
                                `Bearer ${this.token}`
                            );

                            return fetch(url, {
                                ...opciones,
                                headers: headers,
                                credentials: 'same-origin'
                            });
                        },

        
                        // LISTAR USUARIOS CON PAGINACIÓN
            
                        async cargar() {
                            try {
                                const resp = await this.peticionApi(
                                    `${API}/${this.pestana}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`
                                );

                                if (!resp.ok) {
                                    if (resp.status === 401) {
                                        this.mostrarAviso( 'error','La sesión o el token no son válidos. Volvé a iniciar sesión.'
                                        );
                                        return;
                                    }

                                    if (resp.status === 403) {
                                        this.mostrarAviso( 'error','No tenés permisos de administrador para gestionar usuarios.'
                                        );
                                        return;
                                    }

                                    this.mostrarAviso(
                                        'error',
                                        'No se pudieron cargar los usuarios. Código HTTP: ' + resp.status
                                    );
                                    return;
                                }

                                const datos = await resp.json();

                                this.usuarios = datos.items || [];
                                this.total = datos.total || 0;

                                this.totalPaginas = Math.max(
                                    1,
                                    Math.ceil(this.total / this.tamPagina)
                                );

                                if (this.pagina > this.totalPaginas) {
                                    this.pagina = this.totalPaginas;
                                    await this.cargar();
                                }

                            } catch (error) {
                                console.error('Error al cargar usuarios:', error);

                                this.mostrarAviso(
                                    'error',
                                    'No se pudo conectar con el servidor al cargar los usuarios.'
                                );
                            }
                        },

      
                        // SELECCIONAR Y VALIDAR AVATAR
            
                        seleccionarAvatar(evento) {
                            const archivo = evento.target.files[0];

                            this.avatarFile = null;
                            this.avatarPreview = '';

                            if (!archivo)
                                return;

                            const tiposPermitidos = [
                                'image/jpeg',
                                'image/png',
                                'image/webp'
                            ];

                            if (!tiposPermitidos.includes(archivo.type)) {
                                this.mostrarAviso(
                                    'error',
                                    'Seleccioná una imagen JPG, PNG o WEBP.'
                                );

                                evento.target.value = '';
                                return;
                            }

                            if (archivo.size > 5 * 1024 * 1024) {
                                this.mostrarAviso(
                                    'error',
                                    'La imagen no puede superar los 5 MB.'
                                );

                                evento.target.value = '';
                                return;
                            }

                            this.avatarFile = archivo;
                            this.avatarPreview = URL.createObjectURL(archivo);
                        },

          
                        // CREAR O MODIFICAR USUARIO
        
                        async guardar() {
                            if (this.guardando)
                                return;

                            this.guardando = true;
                            this.mensaje = '';

                            try {
                                const editando = this.form.idUsuario > 0;

                                const datos = {
                                    email: this.form.email,
                                    password: this.form.password,
                                    roles: this.form.roles
                                };

                                const resp = await this.peticionApi(
                                    editando
                                        ? `${API}/${this.form.idUsuario}`
                                        : API,
                                    {
                                        method: editando ? 'PUT' : 'POST',
                                        headers: {
                                            'Content-Type': 'application/json'
                                        },
                                        body: JSON.stringify(datos)
                                    }
                                );

                                if (!resp.ok) {
                                    let error = {};

                                    try {
                                        error = await resp.json();
                                    } catch {
                                        // La respuesta podría no ser JSON.
                                    }

                                    this.mostrarAviso(
                                        'error',
                                        error.mensaje ||
                                        'No se pudo guardar el usuario. Código HTTP: ' + resp.status
                                    );

                                    return;
                                }

                                const usuarioGuardado = await resp.json();

                                const idUsuario = editando
                                    ? this.form.idUsuario
                                    : usuarioGuardado.idUsuario;

                                // Subir el avatar si se seleccionó uno.
                                if (this.avatarFile) {
                                    const formData = new FormData();

                                    formData.append(
                                        'avatarFile',
                                        this.avatarFile
                                    );

                                    const respAvatar = await this.peticionApi(
                                        `${API}/${idUsuario}/avatar`,
                                        {
                                            method: 'PUT',
                                            body: formData
                                        }
                                    );

                                    if (!respAvatar.ok) {
                                        let errorAvatar = {};

                                        try {
                                            errorAvatar = await respAvatar.json();
                                        } catch {
                                            // Puede no haber contenido JSON.
                                        }

                                        this.mostrarAviso(
                                            'error',
                                            errorAvatar.mensaje ||
                                            'El usuario se guardó, pero no se pudo actualizar el avatar.'
                                        );

                                        await this.cargar();
                                        return;
                                    }
                                }

                                const habiaAvatar = this.avatarFile !== null;

                                this.limpiar();

                                this.mostrarAviso(
                                    'ok',
                                    habiaAvatar
                                        ? 'Usuario y avatar guardados correctamente.'
                                        : (editando
                                            ? 'Usuario actualizado correctamente.'
                                            : 'Usuario creado correctamente.')
                                );

                                await this.cargar();

                            } catch (error) {
                                console.error('Error al guardar:', error);

                                this.mostrarAviso(
                                    'error',
                                    'Ocurrió un error al conectar con el servidor.'
                                );
                            } finally {
                                this.guardando = false;
                            }
                        },

      
                        // CARGAR USUARIO EN EL FORMULARIO
            
                        editar(usuario) {
                            this.form = {
                                idUsuario: usuario.idUsuario,
                                email: usuario.email,
                                password: '',
                                roles: usuario.roles
                            };

                            this.avatarActual = usuario.avatar || '';
                            this.avatarFile = null;
                            this.avatarPreview = '';

                            window.scrollTo({
                                top: 0,
                                behavior: 'smooth'
                            });
                        },
             
                        // LIMPIAR FORMULARIO
        
                        limpiar() {
                            this.form = formVacio();
                            this.avatarActual = '';
                            this.avatarFile = null;
                            this.avatarPreview = '';
                            this.mensaje = '';
                            const inputArchivo =
                                document.querySelector('input[type="file"]');

                            if (inputArchivo)
                                inputArchivo.value = '';
                        },

                        // DAR DE BAJA A UN USUARIO
          
                        async darDeBaja(usuario) {
                            const confirmar = confirm(
                                `¿Dar de baja al usuario ${usuario.email}?`
                            );

                            if (!confirmar)
                                return;

                            try {
                                const resp = await this.peticionApi(
                                    `${API}/${usuario.idUsuario}`,
                                    {
                                        method: 'DELETE'
                                    }
                                );

                                if (!resp.ok) {
                                    let error = {};

                                    try {
                                        error = await resp.json();
                                    } catch {
                                        // Puede no haber contenido JSON.
                                    }

                                    this.mostrarAviso(
                                        'error',
                                        error.mensaje ||
                                        'No se pudo dar de baja. Código HTTP: ' + resp.status
                                    );

                                    return;
                                }

                                this.mostrarAviso(
                                    'ok', 'Usuario dado de baja correctamente.'
                                );

                                await this.cargar();

                            } catch (error) {
                                console.error('Error al dar de baja:', error);

                                this.mostrarAviso('error', 'No se pudo conectar con el servidor.'
                                );
                            }
                        },

      

           
                        async reactivar(usuario) {
                            try {
                                const resp = await this.peticionApi(
                                    `${API}/${usuario.idUsuario}/reactivar`,
                                    {
                                        method: 'PUT'
                                    }
                                );

                                if (!resp.ok) {
                                    let error = {};

                                    try {
                                        error = await resp.json();
                                    } catch {
                                        // Puede no haber contenido JSON.
                                    }

                                    this.mostrarAviso(
                                        'error',
                                        error.mensaje ||
                                        'No se pudo reactivar. Código HTTP: ' + resp.status
                                    );

                                    return;
                                }

                                this.mostrarAviso(
                                    'ok',
                                    'Usuario reactivado correctamente.'
                                );

                                await this.cargar();

                            } catch (error) {
                                console.error('Error al reactivar:', error);

                                this.mostrarAviso(
                                    'error',  'No se pudo conectar con el servidor.'
                                );
                            }
                        },

           
             
    
                        async cambiarPestana(nombre) {
                            this.pestana = nombre;
                            this.pagina = 1;

                            await this.cargar();
                        },

               
            
                        async cambiarTamano() {
                            this.pagina = 1;

                            await this.cargar();
                        },

             
       
                        async irAPagina(numero) {
                            if (numero < 1 || numero > this.totalPaginas)
                                return;

                            this.pagina = numero;

                            await this.cargar();
                        },


         
                
                        mostrarAviso(tipo, mensaje) {
                            this.mensajeTipo = tipo === 'ok'
                                ? 'ok'
                                : 'error';

                            this.mensaje = mensaje;
                        },



                        // CONVERTIR EN SOCIO

                        convertirEnSocio(usuario) {
                            // Si ya tuvo ficha, se recupera sin pedir datos.
                            if (usuario.socio) {
                                const ok = confirm(
                                    `¿Convertir a ${usuario.email} en socio? ` +
                                    `Se recupera su ficha anterior (${usuario.socio.apellido}, ${usuario.socio.nombre}).`
                                );

                                if (ok)
                                    this.enviarConversion(usuario, {}, false);

                                return;
                            }

                            // Si nunca fue socio, se abre el formulario con los datos.
                            this.usuarioAConvertir = usuario;
                            this.socioForm = socioVacio();
                            this.errorModal = '';
                            this.erroresModal = [];
                            this.modalSocio.show();
                        },

                        // Mismas reglas que el alta de socio (Models/Socio.cs)
                        validarSocio() {
                            const f = this.socioForm;
                            const errores = [];

                            if (!/^[a-zA-ZñÑ\s]{3,20}$/.test(f.nombre.trim()))
                                errores.push('El nombre debe tener entre 3 y 20 letras y espacios.');
                            if (!/^[a-zA-ZñÑ\s]{3,20}$/.test(f.apellido.trim()))
                                errores.push('El apellido debe tener entre 3 y 20 letras y espacios.');
                            if (!/^\d{7,10}$/.test(f.dni.trim()))
                                errores.push('El DNI debe tener entre 7 y 10 dígitos.');
                            if (!/^\d{10,15}$/.test(f.telefono.trim()))
                                errores.push('El teléfono debe tener entre 10 y 15 dígitos.');
                            if (!/^[a-zA-ZñÑ\d\s]{5,20}$/.test(f.domicilio.trim()))
                                errores.push('El domicilio debe tener entre 5 y 20 letras, números y espacios.');

                            return errores;
                        },

                        async confirmarConversion() {
                            if (this.convirtiendo)
                                return;

                            const errores = this.validarSocio();

                            if (errores.length > 0) {
                                this.errorModal = 'Revisá los datos del socio.';
                                this.erroresModal = errores;
                                return;
                            }

                            await this.enviarConversion(this.usuarioAConvertir, this.socioForm, true);
                        },

                        async enviarConversion(usuario, datos, enModal) {
                            this.convirtiendo = true;
                            this.errorModal = '';
                            this.erroresModal = [];

                            try {
                                const resp = await this.peticionApi(
                                    `${API}/${usuario.idUsuario}/convertir-a-socio`,
                                    {
                                        method: 'PUT',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(datos)
                                    }
                                );

                                if (!resp.ok) {
                                    const error = await resp.json().catch(() => ({}));
                                    const texto = error.mensaje || 'No se pudo convertir el usuario.';

                                    if (enModal) {
                                        this.errorModal = texto;
                                        this.erroresModal = error.errores || [];
                                    } else {
                                        this.mostrarAviso('error', texto);
                                    }

                                    return;
                                }

                                if (enModal)
                                    this.modalSocio.hide();

                                this.mostrarAviso('ok', 'El usuario ahora es socio.');
                                await this.cargar();
                            } catch (error) {
                                console.error(error);

                                if (enModal)
                                    this.errorModal = 'No se pudo conectar con el servidor.';
                                else
                                    this.mostrarAviso('error', 'No se pudo conectar con el servidor.');
                            } finally {
                                this.convirtiendo = false;
                            }
                        }

                    }

                }).mount('#app');

            </script>
        }
