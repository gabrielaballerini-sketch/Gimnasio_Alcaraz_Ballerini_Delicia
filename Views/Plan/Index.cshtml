@{
    ViewData["Title"] = "Planes";
}

<div id="app" class="mt-4">

    <h2>Planes</h2>

    <!-- AVISO -->
    <div class="toast-container position-fixed top-0 end-0 p-3"
         style="z-index:1100">

        <div v-if="aviso.texto"
             class="toast show align-items-center text-white border-0"
             v-bind:class="aviso.tipo === 'ok'
                 ? 'bg-success'
                 : 'bg-danger'">

            <div class="d-flex">

                <div class="toast-body">
                    {{ aviso.texto }}
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        v-on:click="aviso.texto = ''">
                </button>

            </div>

        </div>

    </div>


    <!-- MODAL -->
    <div class="modal fade"
         tabindex="-1"
         ref="modalConfirmar">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-body text-center p-4">

                    <div class="mx-auto mb-3 rounded-circle
                                d-flex align-items-center
                                justify-content-center fs-2"
                         style="width:64px;height:64px"
                         v-bind:class="confirmacion.tipo === 'danger'
                             ? 'bg-danger-subtle text-danger'
                             : 'bg-success-subtle text-success'">

                        {{ confirmacion.tipo === 'danger' ? '!' : '✓' }}

                    </div>

                    <h5 class="mb-2">
                        {{ confirmacion.titulo }}
                    </h5>

                    <p class="text-muted mb-3">
                        {{ confirmacion.mensaje }}
                    </p>

                    <div v-if="confirmacion.plan"
                         class="bg-light rounded p-3 mb-3">

                        <div class="fw-semibold">
                            {{ confirmacion.plan.nombre }}
                        </div>

                        <small class="text-muted">
                            $ {{ confirmacion.plan.precio }}
                        </small>

                    </div>

                    <div class="d-flex gap-2 justify-content-center">

                        <button type="button"
                                class="btn btn-light px-4"
                                data-bs-dismiss="modal">

                            Cancelar

                        </button>

                        <button type="button"
                                class="btn px-4"
                                v-bind:class="confirmacion.tipo === 'danger'
                                    ? 'btn-danger'
                                    : 'btn-success'"
                                v-on:click="confirmar">

                            {{ confirmacion.textoBoton }}

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FORMULARIO -->

    <div class="card mb-4">

        <div class="card-header">

            {{ form.idPlan
                ? 'Editar plan'
                : 'Nuevo plan' }}

        </div>

        <div class="card-body">

            <div v-if="mensaje"
                 class="alert alert-danger">

                <div>
                    {{ mensaje }}
                </div>

                <ul class="mb-0"
                    v-if="errores.length">

                    <li v-for="e in errores"
                        v-bind:key="e">

                        {{ e }}

                    </li>

                </ul>

            </div>


            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Nombre
                    </label>

                    <input class="form-control"
                           v-model="form.nombre">

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Tipo de utilización
                    </label>

                    <select class="form-select"
                            v-model="form.tipoUtilizacion">

                        <option value="limitado">
                            Cantidad limitada
                        </option>

                        <option value="ilimitado">
                            Ilimitado
                        </option>

                    </select>

                </div>


                <div class="col-md-4"
                     v-if="form.tipoUtilizacion === 'limitado'">

                    <label class="form-label">
                        Utilizaciones mensuales
                    </label>

                    <input type="number"
                           min="1"
                           class="form-control"
                           v-model.number="form.utilizacionesMensuales">

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Precio
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            $
                        </span>

                        <input type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               v-model.number="form.precio">

                    </div>

                </div>

            </div>


            <div class="mt-3">

                <button class="btn btn-primary me-2"
                        v-on:click="guardar">

                    {{ form.idPlan
                        ? 'Guardar cambios'
                        : 'Crear plan' }}

                </button>

                <button class="btn btn-secondary"
                        v-on:click="limpiar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>


    <!-- PESTAÑAS -->

    <ul class="nav nav-tabs mb-3">

        <li class="nav-item">

            <a href="#"
               class="nav-link"
               v-bind:class="{ active: pestana === 'activos' }"
               v-on:click.prevent="cambiarPestana('activos')">

                Activos

            </a>

        </li>


        <li class="nav-item">

            <a href="#"
               class="nav-link"
               v-bind:class="{ active: pestana === 'inactivos' }"
               v-on:click.prevent="cambiarPestana('inactivos')">

                Inactivos

            </a>

        </li>

    </ul>


    <!-- TABLA -->

    <table class="table table-striped align-middle">

        <thead>

            <tr>

                <th>
                    Nombre
                </th>

                <th>
                    Utilizaciones
                </th>

                <th>
                    Precio
                </th>

                <th>
                </th>

            </tr>

        </thead>

        <tbody>

            <tr v-for="plan in planes"
                v-bind:key="plan.idPlan">

                <td>
                    {{ plan.nombre }}
                </td>

                <td>

                    <span v-if="plan.utilizacionesMensuales">
                        {{ plan.utilizacionesMensuales }}
                    </span>

                    <span v-else
                          class="badge bg-success">

                        Ilimitado

                    </span>

                </td>

                <td>
                    $ {{ plan.precio }}
                </td>

                <td class="text-end">

                    <template v-if="pestana === 'activos'">

                        <button class="btn btn-sm btn-outline-primary me-1"
                                v-on:click="editar(plan)">

                            Editar

                        </button>

                        <button class="btn btn-sm btn-outline-danger"
                                v-on:click="pedirBaja(plan)">

                            Dar de baja

                        </button>

                    </template>


                    <template v-else>

                        <button class="btn btn-sm btn-outline-success"
                                v-on:click="pedirReactivar(plan)">

                            Reactivar

                        </button>

                    </template>

                </td>

            </tr>


            <tr v-if="planes.length === 0">

                <td colspan="4"
                    class="text-center text-muted">

                    No hay planes para mostrar.

                </td>

            </tr>

        </tbody>

    </table>


    <!-- PAGINACIÓN -->

    <div class="d-flex justify-content-between align-items-center">

        <div>

            Mostrando {{ planes.length }}
            de {{ total }} planes

        </div>


        <div class="d-flex align-items-center gap-2">

            <select class="form-select"
                    style="width:auto"
                    v-model.number="tamPagina"
                    v-on:change="cambiarTamano">

                <option :value="5">
                    5
                </option>

                <option :value="10">
                    10
                </option>

                <option :value="20">
                    20
                </option>

            </select>


            <button class="btn btn-outline-secondary"
                    v-on:click="irAPagina(pagina - 1)"
                    v-bind:disabled="pagina <= 1">

                Anterior

            </button>

            <span>
                Página {{ pagina }} de {{ totalPaginas }}
            </span>

            <button class="btn btn-outline-secondary"
                    v-on:click="irAPagina(pagina + 1)"
                    v-bind:disabled="pagina >= totalPaginas">

                Siguiente

            </button>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>

        const API = '/api/planes';


        function formVacio() {

            return {
                idPlan: 0,
                nombre: '',
                utilizacionesMensuales: null,
                precio: 0,
                tipoUtilizacion: 'limitado'
            };

        }


        function confirmacionVacia() {

            return {
                titulo: '',
                mensaje: '',
                textoBoton: '',
                tipo: 'danger',
                plan: null,
                accion: null
            };

        }


        Vue.createApp({

            data() {

                return {

                    planes: [],

                    pestana: 'activos',

                    pagina: 1,

                    tamPagina: 10,

                    total: 0,

                    totalPaginas: 1,

                    form: formVacio(),

                    mensaje: '',

                    errores: [],

                    aviso: {
                        tipo: 'ok',
                        texto: ''
                    },

                    temporizadorAviso: null,

                    confirmacion: confirmacionVacia(),

                    modal: null

                };

            },


            mounted() {

                this.modal =
                    new bootstrap.Modal(
                        this.$refs.modalConfirmar
                    );

                this.cargar();

            },


            methods: {

                mostrarAviso(tipo, texto) {

                    this.aviso = {
                        tipo,
                        texto
                    };

                    clearTimeout(
                        this.temporizadorAviso
                    );

                    this.temporizadorAviso =
                        setTimeout(() => {

                            this.aviso.texto = '';

                        }, 4000);

                },


                async cargar() {

                    const url =
                        `${API}/${this.pestana}?pagina=${this.pagina}&tamPagina=${this.tamPagina}`;

                    const resp =
                        await fetch(url);

                    const datos =
                        await resp.json();


                    if (this.pagina > datos.totalPaginas) {

                        this.pagina =
                            datos.totalPaginas;

                        return this.cargar();

                    }


                    this.planes =
                        datos.items;

                    this.total =
                        datos.total;

                    this.totalPaginas =
                        datos.totalPaginas;

                },


                cambiarPestana(nombre) {

                    if (this.pestana === nombre)
                        return;

                    this.pestana = nombre;

                    this.pagina = 1;

                    this.cargar();

                },


                cambiarTamano() {

                    this.pagina = 1;

                    this.cargar();

                },


                irAPagina(numero) {

                    if (
                        numero < 1 ||
                        numero > this.totalPaginas
                    )
                        return;

                    this.pagina = numero;

                    this.cargar();

                },


                async guardar() {

                    this.mensaje = '';

                    this.errores = [];


                    const editando =
                        this.form.idPlan > 0;


                    const datos =
                        new FormData();


                    datos.append(
                        'nombre',
                        this.form.nombre ?? ''
                    );


                    if (
                        this.form.tipoUtilizacion ===
                        'ilimitado'
                    ) {

                        datos.append(
                            'utilizacionesMensuales',
                            ''
                        );

                    } else {

                        datos.append(
                            'utilizacionesMensuales',
                            this.form.utilizacionesMensuales ?? ''
                        );

                    }


                    datos.append(
                        'precio',
                        this.form.precio ?? ''
                    );


                    const resp =
                        await fetch(
                            editando
                                ? `${API}/${this.form.idPlan}`
                                : API,
                            {
                                method:
                                    editando
                                        ? 'PUT'
                                        : 'POST',

                                body: datos
                            }
                        );


                    if (!resp.ok) {

                        const error =
                            await resp.json();

                        this.mensaje =
                            error.mensaje ||
                            'Ocurrió un error.';

                        this.errores =
                            error.errores || [];

                        return;

                    }


                    this.limpiar();


                    this.mostrarAviso(
                        'ok',
                        editando
                            ? 'Plan actualizado correctamente.'
                            : 'Plan creado correctamente.'
                    );


                    this.cargar();

                },


                editar(plan) {

                    this.mensaje = '';

                    this.errores = [];

                    this.form = {

                        ...plan,

                        tipoUtilizacion:
                            plan.utilizacionesMensuales == null
                                ? 'ilimitado'
                                : 'limitado'

                    };


                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });

                },


                limpiar() {

                    this.form =
                        formVacio();

                    this.mensaje = '';

                    this.errores = [];

                },


                pedirBaja(plan) {

                    this.confirmacion = {

                        titulo:
                            'Dar de baja al plan',

                        mensaje:
                            'Pasará a la lista de inactivos. Podés reactivarlo cuando quieras.',

                        textoBoton:
                            'Dar de baja',

                        tipo:
                            'danger',

                        plan,

                        accion:
                            () =>
                                this.ejecutarBaja(
                                    plan
                                )

                    };


                    this.modal.show();

                },


                pedirReactivar(plan) {

                    this.confirmacion = {

                        titulo:
                            'Reactivar al plan',

                        mensaje:
                            'Volverá a la lista de planes activos.',

                        textoBoton:
                            'Reactivar',

                        tipo:
                            'success',

                        plan,

                        accion:
                            () =>
                                this.ejecutarReactivar(
                                    plan
                                )

                    };


                    this.modal.show();

                },


                async confirmar() {

                    const accion =
                        this.confirmacion.accion;

                    this.modal.hide();

                    if (accion)
                        await accion();

                },


                async ejecutarBaja(plan) {

                    const resp =
                        await fetch(
                            `${API}/${plan.idPlan}`,
                            {
                                method: 'DELETE'
                            }
                        );


                    if (!resp.ok) {

                        const error =
                            await resp.json();

                        this.mostrarAviso(
                            'error',
                            error.mensaje ||
                            'No se pudo dar de baja.'
                        );

                        return;

                    }


                    this.mostrarAviso(
                        'ok',
                        `${plan.nombre} fue dado de baja.`
                    );


                    this.cargar();

                },


                async ejecutarReactivar(plan) {

                    const resp =
                        await fetch(
                            `${API}/${plan.idPlan}/reactivar`,
                            {
                                method: 'PUT'
                            }
                        );


                    if (!resp.ok) {

                        const error =
                            await resp.json();

                        this.mostrarAviso(
                            'error',
                            error.mensaje ||
                            'No se pudo reactivar.'
                        );

                        return;

                    }


                    this.mostrarAviso(
                        'ok',
                        `${plan.nombre} fue reactivado.`
                    );


                    this.cargar();

                }

            }

        }).mount('#app');

    </script>
}